 config --show         # raw config + key reference\n   pos entertainment config set ENABLED=\"weather, 5m gold, 1h\"\n   pos entertainment config set WEATHER_LAT=36.51 WEATHER_LON=40.75\n   pos entertainment config set ENABLED=\"\"\n@@ -48,12 +54,103 @@ EOF\n     exit 0\n }\n \n+# Non-interactive view: config file + ENABLED + the plugin key reference.\n+show() {\n+    echo \"Config: $CONFIG_FILE\"\n+    if [ -f \"$CONFIG_FILE\" ]; then\n+        cat \"$CONFIG_FILE\"\n+    else\n+        echo \"(not created yet — run 'pos entertainment enable <plugin> [interval]' or 'pos entertainment config set ...')\"\n+    fi\n+    echo\n+    echo \"ENABLED: $(config_value ENABLED)\"\n+    echo \"Intervals: 5m 10m 15m 30m 45m hourly 2h 6h 12h daily weekly, or OnCalendar=...\"\n+    echo\n+    echo \"Plugin keys (declared in each plugin's # POS_KEYS: header):\"\n+    keys_section \"$(plugin_dir)\"\n+}\n+\n+# Guided wizard (bare invocation on a TTY): auto-trigger multiselect, plugin\n+# keys with current values as defaults, undeclared-key cleanup.\n+wizard() {\n+    _ent_source_ui || return 1\n+    local d line plugin key desc req cur val\n+    d=\"$(plugin_dir)\"\n+\n+    ui_header \"entertainment config\"\n+    echo \"  Config: $CONFIG_FILE\" >&2\n+    echo \"  ENABLED: $(config_value ENABLED)\" >&2\n+\n+    # 1. Auto-trigger list: multiselect of the installed plugins + intervals.\n+    config_wizard_enabled\n+\n+    # 2. Plugin-declared keys (WEATHER_* etc.), current value as the default.\n+    #    Keys are buffered into an array first: interactive prompts must read\n+    #    the TTY — a herestring loop would feed the next key to the prompts.\n+    local -a pkeys\n+    mapfile -t pkeys < <(config_keys \"$d\")\n+    for line in \"${pkeys[@]:-}\"; do\n+        [ -n \"$line\" ] || continue\n+        IFS='|' read -r plugin key desc req <<<\"$line\"\n+        cur=\"$(config_value \"$key\")\"\n+        if ui_confirm \"${key} — ${desc}${cur:+ (current: ${cur})} — set it?\" \"${req:-n