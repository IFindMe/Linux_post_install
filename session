            "output": "<path>/mnt/hdd/ciya_space/work/repo/Linux_post_install/bin/pos-network-download</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env bash\n2: set -euo pipefail\n3: # POS: network download — aria2 RPC daemon + queue control (add/torrent/metalink, watch, limits)\n4: # POS_SUBCMDS: start stop status add torrent metalink list info files peers pause resume remove purge move limit set watch restart retry\n5: # POS_FLAGS: --dir --out --split --seed --force --upload --gid --tmux\n6: \n7: source \"$(dirname \"$0\")/../lib/common.sh\" 2>/dev/null || source \"$(dirname \"$0\")/common.sh\"\n8: \n9: command -v aria2c &>/dev/null || err \"aria2c not found (install aria2)\"\n10: command -v jq &>/dev/null || err \"jq not found (install jq)\"\n11: command -v curl &>/dev/null || err \"curl not found (install curl)\"\n12: \n13: # ── Config / seams (env overrides for tests) ───────────────────\n14: RPC_PORT=\"${RPC_PORT:-6800}\"\n15: RPC_URL=\"http://127.0.0.1:$RPC_PORT/jsonrpc\"\n16: CONFIG_DIR=\"${CONFIG_DIR:-$HOME/.config/linux_post_install}\"\n17: CONFIG_FILE=\"$CONFIG_DIR/download.env\"\n18: DOWNLOAD_DIR=\"${DOWNLOAD_DIR:-$HOME/Downloads}\"\n19: USER_SYSTEMD_DIR=\"${USER_SYSTEMD_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}\"\n20: SERVICE=\"pos-aria2.service\"\n21: HEALER_SERVICE=\"pos-aria2-retry.service\"\n22: HEALER_TIMER=\"pos-aria2-retry.timer\"\n23: RETRY_STATE=\"$CONFIG_DIR/download.retry\"\n24: NET_PROBE=\"${NET_PROBE:-timeout 3 bash -c '</dev/tcp/8.8.8.8/53>'}\"\n25: RETRY_INTERVAL=\"${RETRY_INTERVAL:-30}\"\n26: RETRY_VERIFY_SLEEP=\"${RETRY_VERIFY_SLEEP:-3}\"\n27: RESTART_NAME=\"\"\n28: \n29: load_secret() {\n30:     if [ -z \"${RPC_SECRET:-}\" ] && [ -f \"$CONFIG_FILE\" ]; then\n31:         RPC_SECRET=$(grep -E '^RPC_SECRET=' \"$CONFIG_FILE\" 2>/dev/null | head -1 | cut -d= -f2-)\n32:     fi\n33:     RPC_SECRET=\"${RPC_SECRET:-}\"\n34: }\n35: load_secret\n36: \n37: # Shared awk helpers: hs = human speed, et = human eta (seconds).\n38: ROW_AWK='\n39: function hs(s){ if(s>=1073741824)return sprintf(\"%.1fG/s\", s/1073741824); if(s>=1048576)return sprintf(\"%.1fM/s\", s/1048576); if(s>=1024)return sprintf(\"%.1fK/s\", s/1024); return sprintf(\"%dB/s\", s) }\n40: function et(s){ s=s+0; if(s<=0)return \"—\"; if(s>=86400)return sprintf(\"%dd%dh\", int(s/86400), int(s%86400/3600)); if(s>=3600)return sprintf(\"%dh%dm\", int(s/3600), int(s%3600/60)); if(s>=60)return sprintf(\"%dm%ds\", int(s/60), s%60); return sprintf(\"%ds\", s) }\n41: '\n42: \n43: usage() {\n44:     cat <<EOF\n45: Usage: pos network download <command> [args]\n46: \n47: aria2 download daemon + queue control. Runs a persistent aria2c with JSON-RPC\n48: (systemd user service on localhost:$RPC_PORT) and drives it via the RPC API.\n49: \n50: Commands:\n51:   start                     Start the daemon (installs the systemd user service, generates RPC secret)\n52:   stop                      Stop the daemon and remove the service\n53:   status                    Daemon health + global transfer stats\n54:   add <url> [<url>...]      Enqueue HTTP/FTP downloads (auto-starts the daemon)\n55:   torrent <file|magnet>...  Enqueue .torrent files or magnet links\n56:   metalink <file|url>       Enqueue a .metalink file or URL\n57:   list                      Show active / waiting / finished downloads\n58:   info <gid>                Full status of one download\n59:   files <gid>               Files of a download\n60:   peers <gid>               Peers of a torrent download\n61:   pause|resume [gid|all]    Pause / resume one or all downloads (default all)\n62:   remove [gid|all]          Remove one or all (--force kills immediately)\n63:   purge                     Clear finished/error download history\n64:   move <gid> <pos>          Reorder the waiting queue\n65:   limit [gid] <speed>       Speed limit, global or per-download (--upload = up; 0 = unlimited)\n66:   set <key=value>...        Set global aria2 options (--gid <gid> = per-download)\n67:   watch [gid]               Live progress, 2s refresh (Ctrl+C to detach)\n68:   restart <gid>             Re-queue a finished/errored download (resumes partial files;\n69:                             torrents re-add via magnet, HTTP via their original URLs)\n70:   retry <gid|all>           Smart retry: waits out internet outages, then re-queues and\n71:                             re-checks; reports real problems (dead source) instead of looping\n72:                             (--once: single check without waiting — used by the healer timer)\n73: \n74: Options (add / torrent / metalink):\n75:   --dir <path>    download directory (default: $DOWNLOAD_DIR)\n76:   --out <name>    output file name (add only)\n77:   --split <n>     connections per download (default: 16)\n78:   --seed          torrent: keep seeding after download (torrent only)\n79:   --tmux          show live progress in a tmux session named after the file\n80:                   (attach with: tmux attach -t dl-<name>)\n81: \n82: Options (retry):\n83:   --interval <s>  poll seconds while waiting for internet (default: 30)\n84:   --max-wait <s>  give up waiting after N seconds (default: 0 = wait forever)\n85:   --once          single pass: no waiting for internet (healer timer mode)\n86:   --quiet         suppress progress output (exit 0 even if retries failed)\n87: \n88: Examples:\n89:   pos network download add https://example.com/ubuntu.iso --tmux\n90:   pos network download add https://example.com/a.bin https://example.com/b.bin --dir /mnt/hdd/dl\n91:   pos network download torrent file.torrent --seed\n92:   pos network download list\n93:   pos network download limit 2M\n94:   pos network download watch\n95:   pos network download restart 2e9dffc4\n96:   pos network download retry all\n97: \n98: Failed downloads are auto-retried by the 'retry healer' systemd timer while the\n99: daemon runs; it arms on download start and disables itself when nothing is left.\n100: \n101: Config: RPC secret in $CONFIG_FILE (chmod 600).\n102: Env:   RPC_PORT, RPC_SECRET, DOWNLOAD_DIR, NET_PROBE override defaults (test seams).\n103: EOF\n104:     exit 0\n105: }\n106: \n107: # ── JSON helpers ────────────────────────────────────────────────\n108: json_arr() { jq -nc '$ARGS.positional' --args \"$@\"; }\n109: json_str() { jq -nc --arg s \"$1\" '$s'; }\n110: \n111: opts_json() {  # key=value... → JSON object\n112:     local kv k v o=\"{}\"\n113:     for kv in \"$@\"; do\n114:         k=\"${kv%%=*}\"; v=\"${kv#*=}\"\n115:         o=$(jq -nc --argjson o \"$o\" --arg k \"$k\" --arg v \"$v\" '$o + {($k): $v}')\n116:     done\n117:     printf '%s' \"$o\"\n118: }\n119: \n120: # ── RPC client ─────────────────────────────────────────────────\n121: rpc() {  # rpc <method> [json-args...]\n122:     local method=\"$1\"; shift\n123:     local params=\"\" a\n124:     for a in \"$@\"; do params=\"$params,$a\"; done\n125:     local body\n126:     body=$(curl -fsS --noproxy '*' -m 60 -H 'Content-Type: application/json' \\\n127:         -d \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":1,\\\"method\\\":\\\"$method\\\",\\\"params\\\":[\\\"token:${RPC_SECRET}\\\"${params}]}\" \\\n128:         \"$RPC_URL\" 2>/dev/null) \\\n129:         || err \"RPC failed — is the daemon running? (pos network download start)\"\n130:     local ecode\n131:     ecode=$(printf '%s' \"$body\" | jq -r '.error.code // empty' 2>/dev/null || true)\n132:     if [ -n \"$ecode\" ]; then\n133:         err \"aria2 RPC error $ecode: $(printf '%s' \"$body\" | jq -r '.error.message // \"?\"')\"\n134:     fi\n135:     printf '%s' \"$body\"\n136: }\n137: \n138: # ── Daemon lifecycle (systemd user service) ────────────────────\n139: daemon_active() { systemctl --user is-active --quiet \"$SERVICE\" 2>/dev/null; }\n140: \n141: cmd_start() {\n142:     if [ -z \"$RPC_SECRET\" ] && [ -f \"$CONFIG_FILE\" ]; then\n143:         RPC_SECRET=$(grep -E '^RPC_SECRET=' \"$CONFIG_FILE\" 2>/dev/null | head -1 | cut -d= -f2-)\n144:     fi\n145:     if [ -z \"$RPC_SECRET\"