              "content": "#!/usr/bin/env bash\nset -uo pipefail\n\nSUITE=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nREPO=/mnt/hdd/ciya_space/work/repo/Linux_post_install\nSCRIPT=\"$REPO/features/usb-automount.sh\"\nRULE='ACTION==\"add\", KERNEL==\"sd[a-z]*\", SUBSYSTEM==\"block\", ENV{ID_BUS}==\"usb\", TAG+=\"systemd\", SYSTEMD_WANTS=\"usb-automount.service\"'\n\nPASS=0\nFAIL=0\n\nok() { PASS=$((PASS + 1)); printf '    ok: %s\\n' \"$1\"; }\nbad() { FAIL=$((FAIL + 1)); printf '    FAIL: %s\\n' \"$1\"; }\n\n# t_start <name> — fresh sandbox in $T\nt_start() {\n    T=\"$(mktemp -d \"$SUITE/t.XXXXXX\")\"\n    mkdir -p \"$T/home\"\n}\n\n# run_script — env from caller; args appended\nrun_script() {\n    HOME=\"$T/home\" \\\n    LSBLK_JSON=\"${LSBLK_JSON:-{\\\"blockdevices\\\":[]}}\" \\\n    MOUNT_LOG=\"$T/mount.log\" \\\n    MOUNTED_FILE=\"$T/mounted\" \\\n    UDEVADM_LOG=\"$T/udevadm.log\" \\\n    SUDO_LOG=\"$T/sudo.log\" \\\n    RULES_DIR=\"$T/rules\" \\\n    AUTOMOUNT_SKIP_ROOT_GUARD=\"${SKIP_ROOT_GUARD:-1}\" \\\n    PATH=\"$SUITE/bin:$PATH\" \\\n    bash \"$SCRIPT\" \"$@\"\n}\n\nexpect_rc() { # expect_rc <desc> <want> <got>\n    if [ \"$3\" = \"$2\" ]; then ok \"$1\"; else bad \"$1 (rc=$3 want $2)\"; fi\n}\ngrep_file() { # grep_file <desc> <pattern> <file>\n    if [ -f \"$3\" ] && grep -q \"$2\" \"$3\"; then ok \"$1\"; else bad \"$1\"; fi\n}\nno_grep_file() { # no_grep_file <desc> <pattern> <file>\n    if [ ! -f \"$3\" ] || ! grep -q \"$2\" \"$3\"; then ok \"$1\"; else bad \"$1\"; fi\n}\ncount_lines() { # count_lines <desc> <file> <want>\n    local got=0\n    [ -f \"$2\" ] && got=\"$(wc -l < \"$2\")\"\n    if [ \"$got\" = \"$3\" ]; then ok \"$1\"; else bad \"$1 (got $got want $3)\"; fi\n}\n\n# ── 1. mounts an unmounted removable partition ──────────────────\ntest_mounts_partition() {\n    t_start\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/part.json\")\" run_script\n    expect_rc \"mounts_partition: exit 0\" 0 \"$?\"\n    count_lines \"mounts_partition: exactly one mount\" \"$T/mount.log\" 1\n    grep_file \"mounts_partition: umask=000 call\" '^mount -o umask=000 /dev/sdb1 /media/WORK$' \"$T/mount.log\"\n    grep_file \"mounts_partition: marker\" '^/media/WORK$' \"$T/mounted\"\n    grep_file \"mounts_partition: log line\" 'mounted /dev/sdb1 -> /media/WORK (umask=000, world-writable)' \"$T/home/.usb-automount.log\"\n    grep_file \"mounts_partition: udev rule written\" 'SYSTEMD_WANTS=\"usb-automount.service\"' \"$T/rules/99-usb-automount.rules\"\n}\n\n# ── 2. skips already-mounted devices ────────────────────────────\ntest_skips_mounted() {\n    t_start\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/mounted.json\")\" run_script\n    expect_rc \"skips_mounted: exit 0\" 0 \"$?\"\n    no_grep_file \"skips_mounted: no mount call\" 'mount' \"$T/mount.log\"\n}\n\n# ── 3. skips non-removable media ────────────────────────────────\ntest_skips_nonremovable() {\n    t_start\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/nonremovable.json\")\" run_script\n    expect_rc \"skips_nonremovable: exit 0\" 0 \"$?\"\n    no_grep_file \"skips_nonremovable: no mount call\" 'mount' \"$T/mount.log\"\n}\n\n# ── 4. raw whole-disk filesystem ────────────────────────────────\ntest_raw_whole_disk() {\n    t_start\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/raw-disk.json\")\" run_script\n    expect_rc \"raw_whole_disk: exit 0\" 0 \"$?\"\n    grep_file \"raw_whole_disk: mounts raw disk\" '^mount -o umask=000 /dev/sdb /media/STICK$' \"$T/mount.log\"\n    grep_file \"raw_whole_disk: marker\" '^/media/STICK$' \"$T/mounted\"\n}\n\n# ── 5. label collision dedupes to -2 ────────────────────────────\ntest_dedupe_collision() {\n    t_start\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/dup-label.json\")\" run_script\n    expect_rc \"dedupe: exit 0\" 0 \"$?\"\n    grep_file \"dedupe: first at /media/DATA\" '^mount -o umask=000 /dev/sdb1 /media/DATA$' \"$T/mount.log\"\n    grep_file \"dedupe: second at /media/DATA-2\" '^mount -o umask=000 /dev/sdc1 /media/DATA-2$' \"$T/mount.log\"\n    grep_file \"dedupe: marker -2\" '^/media/DATA-2$' \"$T/mounted\"\n}\n\n# ── 6. umask rejected → plain mount fallback ────────────────────\ntest_umask_fallback() {\n    t_start\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/part.json\")\" MOUNT_FAIL_UMASK=1 run_script\n    expect_rc \"umask_fallback: exit 0\" 0 \"$?\"\n    grep_file \"umask_fallback: plain mount retried\" '^mount /dev/sdb1 /media/WORK$' \"$T/mount.log\"\n    grep_file \"umask_fallback: log line\" 'mounted /dev/sdb1 -> /media/WORK (plain)' \"$T/home/.usb-automount.log\"\n}\n\n# ── 7. total mount failure logged, exit 0 ───────────────────────\ntest_mount_failure() {\n    t_start\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/part.json\")\" MOUNT_FAIL_ALL=1 run_script\n    expect_rc \"mount_failure: exit 0\" 0 \"$?\"\n    grep_file \"mount_failure: FAILED logged\" 'FAILED to mount /dev/sdb1 -> /media/WORK' \"$T/home/.usb-automount.log\"\n    no_grep_file \"mount_failure: no marker\" '^/media/WORK$' \"$T/mounted\"\n}\n\n# ── 8. repeated runs are no-ops on mounted devices ──────────────\ntest_idempotent() {\n    t_start\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/mounted.json\")\" run_script\n    expect_rc \"idempotent: first run rc\" 0 \"$?\"\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/mounted.json\")\" run_script\n    expect_rc \"idempotent: second run rc\" 0 \"$?\"\n    no_grep_file \"idempotent: no mount call\" 'mount' \"$T/mount.log\"\n}\n\n# ── 9. udev rule installed once, not rewritten ──────────────────\ntest_udev_rule_once() {\n    t_start\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/part.json\")\" run_script\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/part.json\")\" run_script\n    expect_rc \"udev_rule_once: runs ok\" 0 \"$?\"\n    count_lines \"udev_rule_once: reload+trigger only once\" \"$T/udevadm.log\" 2\n    if [ \"$(cat \"$T/rules/99-usb-automount.rules\")\" = \"$RULE\" ]; then ok \"udev_rule_once: content matches\"; else bad \"udev_rule_once: content matches\"; fi\n}\n\n# ── 10. edited udev rule is preserved ───────────────────────────\ntest_udev_rule_preserves_edits() {\n    t_start\n    mkdir -p \"$T/rules\"\n    printf '# custom tweak\\n' > \"$T/rules/99-usb-automount.rules\"\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/part.json\")\" run_script\n    expect_rc \"udev_preserve: exit 0\" 0 \"$?\"\n    if [ \"$(cat \"$T/rules/99-usb-automount.rules\")\" = \"# custom tweak\" ]; then ok \"udev_preserve: edits kept\"; else bad \"udev_preserve: edits kept\"; fi\n    count_lines \"udev_preserve: no udevadm calls\" \"$T/udevadm.log\" 0\n}\n\n# ── 11. non-root run re-execs via sudo ──────────────────────────\ntest_root_guard() {\n    t_start\n    SKIP_ROOT_GUARD=0 LSBLK_JSON=\"$(cat \"$SUITE/fixtures/part.json\")\" run_script\n    expect_rc \"root_guard: exit 0\" 0 \"$?\"\n    grep_file \"root_guard: sudo invoked\" \"sudo $SCRIPT\" \"$T/sudo.log\"\n    grep_file \"root_guard: mount still happened\" '^mount -o umask=000 /dev/sdb1 /media/WORK$' \"$T/mount.log\"\n}\n\n# ── 12. -h|--help ──────────────────────────────────────────────\ntest_help() {\n    t_start\n    run_script -h\n    expect_rc \"help: exit 0\" 0 \"$?\"\n    no_grep_file \"help: no mount\" 'mount' \"$T/mount.log\"\n    no_grep_file \"help: no udev rule dir\" '.' \"$T/rules/99-usb-automount.rules\"\n}\n\n# ── 13. device without label → /media/usb-<name> ────────────────\ntest_no_label() {\n    t_start\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/nolabel.json\")\" run_script\n    expect_rc \"no_label: exit 0\" 0 \"$?\"\n    grep_file \"no_label: fallback mountpoint\" '^mount -o umask=000 /dev/sdb1 /media/usb-sdb1$' \"$T/mount.log\"\n}\n\n# ── 14. lsblk failure → log + non-zero exit ─────────────────────\ntest_lsblk_failure() {\n    t_start\n    LSBLK_FAIL=1 run_script\n    expect_rc \"lsblk_failure: exit 1\" 1 \"$?\"\n    grep_file \"lsblk_failure: logged\" 'lsblk failed' \"$T/home/.usb-automount.log\"\n}\n\n# ── 15. multiple partitions on one disk ─────────────────────────\ntest_two_labels() {\n    t_start\n    LSBLK_JSON=\"$(cat \"$SUITE/fixtures/two-labels.json\")\" run_script\n    expect_rc \"two_labels: exit 0\" 0 \"$?\"\n    grep_file \"two_labels: DATA\" '^mount -o umask=000 /dev/sdb1 /media/DATA$' \"$T/mount.log\"\n    grep_file \"two_labels: BACKUP\" '^mount -o umask=000 /dev/sdb2 /media/BACKUP$' \"$T/mount.log\"\n}\n\n# ── 16. empty device list → clean no-op ─────────────────────────\ntest_empty() {\n    t_start\n    run_script\n    expect_rc \"empty: exit 0\" 0 \"$?\"\n    no_grep_file \"empty: no mount\" 'mount' \"$T/mount.log\"\n}\n\nmain() {\n    for t in test_mounts_partition test_skips_mounted test_skips_nonremovable \\\n             test_raw_whole_disk test_dedupe_collision test_umask_fallback \\\n             test_mount_failure test_idempotent test_udev_rule_once \\\n             test_udev_rule_preserves_edits test_root_guard test_help \\\n             test_no_label test_lsblk_failure test_two_labels test_empty; do\n        printf '%s\\n' \"== $t\"\n        \"$t\"\n    done\n    printf '\\n%s %d, %s %d\\n' \"PASS:\" \"$PASS\" \"FAIL:\" \"$FAIL\"\n    [ \"$FAIL\" -eq 0 ]\n}\n\nmain \"$@\"\n",
