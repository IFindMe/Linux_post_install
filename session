d_peers() {\n671:     local gid=\"${1:-}\"\n672:     [ -n \"$gid\" ] || err \"peers: gid required\"\n673:     rpc aria2.getPeers \"$(json_str \"$gid\")\" | jq -r '.result[] | [.peerId[0:12], .ip, (.port|tostring), .downloadSpeed, .uploadSpeed, ((.progress|tonumber) * 100)] | @tsv' \\\n674:         | awk -F'\\t' \"$ROW_AWK\"'{ printf \"  %-12s %-16s %6s  dl %s  up %s  %5.1f%%\\n\", $1, $2, $3, hs($4), hs($5), $6 }'\n675: }\n676: \n677: # ── Queue control ──────────────────────────────────────────────\n678: queue_cmd() {\n679:     local single=\"$1\" all=\"$2\" verb=\"$3\" target=\"${4:-all}\"\n680:     if [ \"$target\" = \"all\" ]; then\n681:         rpc \"$all\" >/dev/null\n682:     else\n683:         rpc \"$single\" \"$(json_str \"$target\")\" >/dev/null\n684:     fi\n685:     log \"$verb: $target\"\n686: }\n687: \n688: cmd_pause()  { queue_cmd aria2.pause  aria2.pauseAll  \"paused\"  \"$@\"; }\n689: cmd_resume() { queue_cmd aria2.unpause aria2.unpauseAll \"resumed\" \"$@\"; }\n690: \n691: cmd_remove() {\n692:     local force=0 target=\"${1:-all}\"\n693:     if [ \"${1:-}\" = \"--force\" ]; then force=1; target=\"${2:-all}\"; fi\n694:     if [ \"$target\" = \"all\" ]; then\n695:         if [ \"$force\" -eq 1 ]; then rpc aria2.forceRemoveAll >/dev/null; else rpc aria2.removeAll >/dev/null; fi\n696:     else\n697:         if [ \"$force\" -eq 1 ]; then rpc aria2.forceRemove \"$(json_str \"$target\")\" >/dev/null; else rpc aria2.remove \"$(json_str \"$target\")\" >/dev/null; fi\n698:     fi\n699:     log \"removed: $target\"\n700: }\n701: \n702: cmd_purge() { rpc aria2.purgeDownloadResult >/dev/null; log \"download history purged\"; }\n703: \n704: cmd_move() {\n705:     local gid=\"${1:-}\" pos=\"${2:-}\"\n706:     [ -n \"$gid\" ] && [ -n \"$pos\" ] || err \"move: usage: pos network download move <gid> <position>\"\n707:     local newpos\n708:     newpos=$(rpc aria2.changePosition \"$(json_str \"$gid\")\" \"$(json_str \"$pos\")\" \"$(json_str \"POS_SET\")\" | jq -r '.result')\n709:     log \"moved $gid to position $newpos\"\n710: }\n711: \n712: # ── Tuning ─────────────────────────────────────────────────────\n713: cmd_limit() {\n714:     local upload=0 gid=\"\" speed=\"\"\n715:     while [ $# -gt 0 ]; do\n716:         case \"$1\" in\n717:             --upload) upload=1; shift ;;\n718:             -h|--help) usage ;;\n719:             -*) err \"limit: unknown option: $1\" ;;\n720:             *) if [ -z \"$speed\" ]; then speed=\"$1\"; else gid=\"$speed\"; speed=\"$1\"; fi; shift ;;\n721:         esac\n722:     done\n723:     [ -n \"$speed\" ] || err \"limit: speed required (0 = unlimited; e.g. 2M)\"\n724:     local key=\"max-overall-download-limit\"\n725:     if [ \"$upload\" -eq 1 ]; then key=\"max-overall-upload-limit\"; fi\n726:     if [ -n \"$gid\" ]; then\n727:         key=\"max-download-limit\"; [ \"$upload\" -eq 1 ] && key=\"max-upload-limit\"\n728:         rpc aria2.changeOption \"$(json_str \"$gid\")\" \"$(opts_json \"$key=$speed\")\" >/dev/null\n729:         log \"limit: $gid $key=$speed\"\n730:     else\n731:         rpc aria2.changeGlobalOption \"$(opts_json \"$key=$speed\")\" >/dev/null\n732:         log \"limit: global $key=$speed\"\n733:     fi\n734: }\n735: \n736: cmd_set() {\n737:     local gid=\"\" kvs=()\n738:     while [ $# -gt 0 ]; do\n739:         case \"$1\" in\n740:             --gid)   gid=\"${2:-}\"; shift 2 ;;\n741:             --gid=*) gid=\"${1#*=}\"; shift ;;\n742:             -h|--help) usage ;;\n743:             -*) err \"set: unknown option: $1\" ;;\n744:             *) kvs+=(\"$1\"); shift ;;\n745:         esac\n746:     done\n747:     [ ${#kvs[@]} -gt 0 ] || err \"set: need key=value (see: aria2c --help=#rpc-options)\"\n748:     local opts\n749:     opts=$(opts_json \"${kvs[@]}\")\n750:     if [ -n \"$gid\" ]; then\n751:         rpc aria2.changeOption \"$gid\" \"$opts\" >/dev/null\n752:         log \"set: gid $gid — ${kvs[*]}\"\n753:     else\n754:         rpc aria2.changeGlobalOption \"$opts\"