              "patch": "Index: bin/pos-entertainment-config\n===================================================================\n--- bin/pos-entertainment-config\t\n+++ bin/pos-entertainment-config\t\n@@ -1,190 +1,99 @@\n #!/usr/bin/env bash\n set -euo pipefail\n # POS: entertainment config — Show or edit the entertainment config (ENABLED auto-trigger list, weather location)\n-# POS_CONFIG: entertainment | entertainment.env | ENABLED=list:Auto-trigger list (plugin, interval pairs)::weather,5m joke,10m | *plugins\n+# POS_CONFIG: entertainment | entertainment.env | ENABLED=:Auto-trigger list (plugin, interval pairs)::weather,5m joke,10m | *plugins\n \n source \"$(dirname \"$0\")/../lib/common.sh\" 2>/dev/null || source \"$(dirname \"$0\")/common.sh\"\n source \"$(dirname \"$0\")/../lib/entertainment-lib.sh\" 2>/dev/null || source \"$(dirname \"$0\")/entertainment-lib.sh\"\n \n keys_section() {\n     # Renders the Keys reference: ENABLED + every key declared by installed\n     # plugins (via their # POS_KEYS: headers), aligned by key name.\n     local d=\"$1\" maxw=8 line key plugin desc req\n     while IFS= read -r line; do\n         IFS='|' read -r _plugin key _desc _req <<<\"$line\"\n         [ ${#key} -gt \"$maxw\" ] && maxw=${#key}\n     done <<< \"$(config_keys \"$d\")\"\n \n     printf '  %-*s %s\\n' \"$maxw\" \"ENABLED\" \"Auto-trigger list: comma-separated 'plugin, interval' pairs,\"\n     printf '  %-*s %s\\n' \"$maxw\" \"\" \"e.g. ENABLED=\\\"weather, 5m gold, 1h\\\"\"\n     while IFS= read -r line; do\n         [ -n \"$line\" ] || continue\n         IFS='|' read -r plugin key desc req <<<\"$line\"\n         printf '  %-*s %s (%s)  [%s]\\n' \"$maxw\" \"$key\" \"$desc\" \"$req\" \"$plugin\"\n     done <<< \"$(config_keys \"$d\")\"\n     printf '  %-*s %s\\n' \"$maxw\" \"<any>\" \"UPPER_SNAKE key settable freely; a warning is shown if no installed plugin declares it\"\n }\n \n usage() {\n     cat <<EOF\n-Usage: pos entertainment config [set KEY=VALUE ...] [--show]\n+Usage: pos entertainment config [set KEY=VALUE ...]\n \n-Show or edit the entertainment config. Bare invocation on a terminal opens the\n-interactive wizard: the auto-trigger list becomes a multiselect of the\n-installed plugins (one interval per new selection), plugin keys are prompted\n-with their current values as defaults, and keys no installed plugin declares\n-are offered for removal. '--show' prints the raw config + key reference, and\n-'set' sets keys non-interactively. After 'set' (or any ENABLED change), the\n-auto-trigger timers are re-synced.\n+Show the entertainment config file, or set one or more keys.\n+After 'set', auto-trigger timers are re-synced from ENABLED.\n \n Config file: $CONFIG_FILE\n \n Keys (declared by the installed plugins' # POS_KEYS: headers):\n $(keys_section \"$(plugin_dir)\")\n \n Intervals: 5m 10m 15m 30m 45m hourly 2h 6h 12h daily weekly, or OnCalendar=...\n \n Examples:\n-  pos entertainment config                # interactive wizard\n-  pos entertainment config --show         # raw config + key reference\n+  pos entertainment config\n   pos entertainment config set ENABLED=\"weather, 5m gold, 1h\"\n   pos entertainment config set WEATHER_LAT=36.51 WEATHER_LON=40.75\n   pos entertainment config set ENABLED=\"\"\n EOF\n     exit 0\n }\n \n-# Non-interactive view: config file + ENABLED + the plugin key reference.\n-show() {\n-    echo \"Config: $CONFIG_FILE\"\n-    if [ -f \"$CONFIG_FILE\" ]; then\n-        cat \"$CONFIG_FILE\"\n-    else\n-        echo \"(not created yet — run 'pos entertainment enable <plugin> [interval]' or 'pos entertainment config set ...')\"\n-    fi\n-    echo\n-    echo \"ENABLED: $(config_value ENABLED)\"\n-    echo \"Intervals: 5m 10m 15m 30m 45m hourly 2h 6h 12h daily weekly, or OnCalendar=...\"\n-    echo\n-    echo \"Plugin keys (declared in each plugin's # POS_KEYS: header):\"\n-    keys_section \"$(plugin_dir)\"\n-}\n-\n-# Guided wizard (bare invocation on a TTY): auto-trigger multiselect, plugin\n-# keys with current values as defaults, undeclared-key cleanup.\n-wizard() {\n-    _ent_source_ui || return 1\n-    local d line plugin key desc req cur val\n-    d=\"$(plugin_dir)\"\n-\n-    ui_header \"entertainment config\"\n-    echo \"  Config: $CONFIG_FILE\" >&2\n-    echo \"  ENABLED: $(config_value ENABLED)\" >&2\n-\n-    # 1. Auto-trigger list: multiselect of the installed plugins + intervals.\n-    config_wizard_enabled\n-\n-    # 2. Plugin-declared keys (WEATHER_* etc.), current value as the default.\n-    #    Keys are buffered into an array first: interactive prompts must read\n-    #    the TTY — a herestring loop would feed the next key to the prompts.\n-    local -a pkeys\n-    mapfile -t pkeys < <(config_keys \"$d\")\n-    for line in \"${pkeys[@]:-}\"; do\n-        [ -n \"$line\" ] || continue\n-        IFS='|' read -r plugin key desc req <<<\"$line\"\n-        cur=\"$(config_value \"$key\")\"\n-        if ui_confirm \"${key} — ${desc}${cur:+ (current: ${cur})} — set it?\" \"${req:-n}\"; then\n-            # Well-known numeric keys get validated input; everything else is free text.\n-            case \"$key\" in\n-                WEATHER_LAT|WEATHER_LON)\n-                    val=\"$(ui_validate_num float \"$key (e.g. 36.51)\" \"$cur\")\" || { warn \"aborted — $key unchanged\"; continue; }\n-                    ;;\n-                *)\n-                    val=\"$(ui_input \"$key ($desc)\" \"$cur\")\" || { warn \"aborted — $key unchanged\"; continue; }\n-                    ;;\n-            esac\n-            [ -z \"$val\" ] && continue\n-            [ \"$val\" = \"$cur\" ] && continue\n-            if [ \"$val\" = \"-\" ]; then\n-                remove_config_key \"$key\"\n-                log \"cleared $key\"\n-            else\n-                write_config_key \"$key\" \"$val\"\n-                ok \"$key = $val saved\"\n-            fi\n-        fi\n-    done\n-\n-    # 3. Keys in the file that no installed plugin declares: offer removal\n-    #    instead of the old late \"saving anyway\" warning.\n-    local -A declared=()\n-    declared[ENABLED]=1\n-    while IFS= read -r line; do\n-        IFS='|' read -r _plugin key _d _r <<<\"$line\"\n-        [ -n \"$key\" ] && declared[$key]=1\n-    done <<< \"$(config_keys \"$d\")\"\n-    local k\n-    if [ -f \"$CONFIG_FILE\" ]; then\n-        # Same buffering as step 2 — the removal confirm must read the TTY.\n-        local -a fkeys\n-        mapfile -t fkeys < <(grep -E '^[A-Z_]+=' \"$CONFIG_FILE\" || true)\n-        for line in \"${fkeys[@]:-}\"; do\n-            IFS='=' read -r k _v <<<\"$line\"\n-            [ -n \"$k\" ] || continue\n-            case \"$k\" in \\#*) continue ;; esac\n-            [ -n \"${declared[$k]:-}\" ] && continue\n-            cur=\"$(config_value \"$k\")\"\n-            if ui_confirm \"'$k' is not declared by any installed plugin (value: ${cur:-empty}) — remove it?\" y; then\n-                remove_config_key \"$k\"\n-                log \"removed $k\"\n-            fi\n-        done\n-    fi\n-\n-    echo \"Entertainment config done.\" >&2\n-}\n-\n key_known() {\n     config_key_known \"$(plugin_dir)\" \"$1\"\n }\n \n case \"${1:-}\" in\n     -h|--help) usage ;;\n-    --show) show ;;\n     set)\n         shift\n         [ $# -ge 1 ] || usage\n         # Validate every KEY=VALUE pair first — all or nothing, so a typo'd\n         # arg (e.g. 'ENABLED =\"x\"') can't partially write or clear a key.\n         for pair in \"$@\"; do\n             case \"$pair\" in\n                 *=*)\n                     key=\"${pair%%=*}\"\n                     val=\"${pair#*=}\"\n                     ;;\n                 *)\n                     err \"Invalid entry '$pair' — expected KEY=VALUE with no spaces around '=', e.g. ENABLED=\\\"gold, 1h\\\"\"\n                     ;;\n             esac\n             [[ \"$key\" =~ ^[A-Z][A-Z0-9_]*$ ]] || \\\n                 err \"Invalid key '$key' in '$pair' (expected UPPER_SNAKE, e.g. WEATHER_LAT)\"\n             [ -z \"$val\" ] && [ \"$key\" != \"ENABLED\" ] && err \"No value given for '$key' (expected $key=...)\"\n             key_known \"$key\" || warn \"Key '$key' not referenced by any installed plugin — saving anyway\"\n         done\n         for pair in \"$@\"; do\n             key=\"${pair%%=*}\"\n             val=\"${pair#*=}\"\n             write_config_key \"$key\" \"$val\"\n             ok \"$key saved to $CONFIG_FILE\"\n         done\n         sync_timers\n         ;;\n     *)\n-        # Interactive wizard on a terminal; raw view when not (scripts/pipes).\n-        if [ -t 0 ]; then\n-            wizard\n+        echo \"Config: $CONFIG_FILE\"\n+        if [ -f \"$CONFIG_FILE\" ]; then\n+            cat \"$CONFIG_FILE\"\n         else\n-            show\n+            echo \"(not created yet — run 'pos entertainment enable <plugin> [interval]' or 'pos entertainment config set ...')\"\n         fi\n+        echo\n+        echo \"ENABLED: $(config_value ENABLED)\"\n+        echo \"Intervals: 5m 10m 15m 30m 45m hourly 2h 6h 12h daily weekly, or OnCalendar=...\"\n+        echo\n+        echo \"Plugin keys (declared in each plugin's # POS_KEYS: header):\"\n+        keys_section \"$(plugin_dir)\"\n         ;;\n esac\n",
