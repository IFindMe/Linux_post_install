            "output": "<path>/mnt/hdd/ciya_space/work/repo/Linux_post_install/lib/eventer-lib.sh</path>\n<type>file</type>\n<content>\n1: # lib/eventer-lib.sh — shared library for `pos system event-trigger`.\n2: # Sourced by bin/pos-system-event-trigger AFTER lib/common.sh.\n3: #\n4: # eventer reads a list of independent RULES from event.env, one per line:\n5: #\n6: #     \"High CPU temp\" if sensors -u | grep -m1 temp1_input | awk '{print $2}' > 60c\n7: #     disk root > 80%\n8: #     loadavg >= 4\n9: #\n10: # Grammar:  [\"<message>\" if ] <inline-check-command> <op> <threshold>\n11: #   - optional message before the last ' if ' (quote-stripped) = alert text\n12: #   - the operator is the RIGHTMOST '>= <= == != > <' whose RHS parses as a\n13: #     number (a unit suffix like 60c / 80% is fine) — everything before it is\n14: #     the check command, the number is the threshold\n15: #   - the check command is run and its FIRST numeric token is compared (float).\n16: #   State-based alerting: notify on false→true, one recovery on true→false.\n17: #\n18: # NOTE: rules are arbitrary shell commands (the user's own config, chmod 600),\n19: # the same trust model as the Telegram listener's command map.\n20: \n21: CONFIG_FILE=\"${EVENT_CONFIG:-$HOME/.config/linux_post_install/event.env}\"\n22: EVENT_STATE_DIR=\"${EVENT_STATE_DIR:-$HOME/.local/share/linux_post_install/eventer/state}\"\n23: USER_SYSTEMD_DIR=\"${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user\"\n24: EVENT_UNIT=\"pos-event-trigger\"\n25: EVENT_RUNNER=\"$(command -v pos-system-event-trigger 2>/dev/null || echo /usr/local/bin/pos-system-event-trigger)\"\n26: \n27: # common.sh helpers (guarded so the lib is safe if common.sh wasn't loaded)\n28: declare -F err  >/dev/null || err()  { echo \"ERROR: $*\" >&2; exit 1; }\n29: declare -F warn >/dev/null || warn() { echo \"[!] $*\"; }\n30: declare -F ok   >/dev/null || ok()   { echo \"  OK $*\"; }\n31: declare -F log  >/dev/null || log()  { echo \"[+] $*\"; }\n32: \n33: # ── Rule file helpers ────────────────────────────────────────────\n34: # Fills the global array RULES with every line of the file (raw).\n35: eventer_read_rules() {\n36:     RULES=()\n37:     [ -f \"$CONFIG_FILE\" ] || return 0\n38:     local line\n39:     while IFS= read -r line || [ -n \"$line\" ]; do\n40:         RULES+=(\"$line\")\n41:     done < \"$CONFIG_FILE\"\n42: }\n43: \n44: eventer_write_rules() {\n45:     mkdir -p \"$(dirname \"$CONFIG_FILE\")\"\n46:     local tmp\n47:     tmp=\"$(mktemp)\"\n48:     printf '%s\\n' \"${RULES[@]}\" >\"$tmp\"\n49:     mv \"$tmp\" \"$CONFIG_FILE\"\n50:     chmod 600 \"$CONFIG_FILE\"\n51: }\n52: \n53: eventer_count_rules() {\n54:     local i n=0 line\n55:     for line in \"${RULES[@]}\"; do\n56:         line=\"${line#\"${line%%[![:space:]]*}\"}\"   # trim leading whitespace\n57:         [ -n \"$line\" ] && [[ \"$line\" != \\#* ]] && n=$((n + 1))\n58:     done\n59:     printf '%s' \"$n\"\n60: }\n61: \n62: # ── Rule parsing ─────────────────────────────────────────────────\n63: # eventer_parse_rule \"<line>\" — on success sets RULE_MSG, RULE_CMD,\n64: # RULE_OP, RULE_THRESH, RULE_NUM and returns 0; otherwise returns 1.\n65: # Also supports bare \"CMD OP THRESH\" (no message) and \"MSG if CMD OP THRESH\".\n66: eventer_parse_rule() {\n67:     local line=\"$1\" cond=\"\" msg=\"\" s m parts=\"\" i\n68:     s=\"$line\"\n69:     while [[ \"$s\" == *\" if \"* ]]; do\n70:         m=\"${s%% if *}\"\n71:         s=\"${s#*\" if \"}\"\n72:         if [[ \"$s\" == *\" if \"* ]]; then\n73:             parts+=\"${m} if \"\n74:         else\n75:             parts+=\"${m}\"\n76:         fi\n77:     done\n78:     msg=\"$parts\"\n79:     cond=\"$s\"\n80:     [ -n \"$cond\" ] || return 1\n81: \n82:     local -a tokens=()\n83:     read -r -a tokens <<< \"$cond\"\n84:     local n=${#tokens[@]}\n85:     [ \"$n\" -ge 2 ] || return 1\n86:     for ((i=n-2; i>=0; i--)); do\n87:         case \"${tokens[i]}\" in\n88:             \">=\"|\"<=\"|\"==\"|\"!=\"|\">\"|\"<\")\n89:                 if eventer_numeric \"${tokens[i+1]}\" >/dev/null 2>&1; then\n90:                     RULE_OP=\"${tokens[i]}\"\n91:                     RULE_THRESH=\"${tokens[i+1]}\"\n92:                     RULE_NUM=\"$(eventer_numeric \"${tokens[i+1]}\")\"\n93:                     if [ \"$i\" -eq 0 ]; then\n94:                         RULE_CMD=\"${tokens[0]}\"\n95:                     else\n96:                         RULE_CMD=\"$(printf '%s ' \"${tokens[@]:0:i}\")\"\n97:                         RULE_CMD=\"${RULE_CMD% }\"\n98:                     fi\n99:                     RULE_MSG=\"$(eventer_strip_quotes \"$msg\")\"\n100:                     return 0\n101:                 fi ;;\n102:         esac\n103:     done\n104:     return 1\n105: }\n106: \n107: # First numeric prefix of a string (allows a unit suffix: 60c, 80%, 10g).\n108: eventer_numeric() {\n109:     if [[ \"$1\" =~ ^[+-]?([0-9]+([.][0-9]+)?|[.][0-9]+) ]]; then\n110:         printf '%s' \"${BASH_REMATCH[0]}\"\n111:         return 0\n112:     fi\n113:     return 1\n114: }\n115: \n116: eventer_strip_quotes() {\n117:     local v=\"$1\"\n118:     v=\"${v#\\\"}\"; v=\"${v%\\\"}\"\n119:     v=\"${v#\\'}\"; v=\"${v%\\'}\"\n120:     printf '%s' \"$v\"\n121: }\n122: \n123: # Float-safe numeric comparison. Returns 0 if $1 $2 $3 is TRUE.\n124: eventer_compare() {\n125:     awk -v a=\"$1\" -v op=\"$2\" -v b=\"$3\" 'BEGIN{\n126:         if (op==\">\")  exit (a>b)  ? 0 : 1\n127:         if (op==\"<\")  exit (a<b)  ? 0 : 1\n128:         if (op==\">=\") exit (a>=b) ? 0 : 1\n129:         if (op==\"<=\") exit (a<=b) ? 0 : 1\n130:         if (op==\"==\") exit (a==b) ? 0 : 1\n131:         if (op==\"!=\") exit (a!=b) ? 0 : 1\n132:         exit 1\n133:     }'\n134: }\n135: \n136: # ── Running a check ──────────────────────────────────────────────\n137: # eventer_eval_check — runs RULE_CMD, sets VALUE_DISPLAY (first numeric\n138: # token as printed) and VALUE_NUM (its numeric prefix). Returns 0 on success.\n1