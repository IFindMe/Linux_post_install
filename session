45: \n46: ```\n47: Linux_post_install/\n48: ├── install.sh              # Main orchestrator — entry point\n49: ├── preinstall.sh           # Phase 1: system packages via apt + yt-dlp\n50: ├── postinstall.sh          # Phase 3: PATH, bash completion, systemd services\n51: │\n52: ├── lib/\n53: │   ├── common.sh           # Shared library (colors, logging, spinner, timer, run, load_system_env)\n54: │   ├── flags.sh            # Feature flag store (flag_set/clear/is_set/value/list/status)\n55: │   ├── notify.sh           # Multi-platform alerting (notify_send) — sourced opt-in, silent-fails\n56: │   └── entertainment-lib.sh # Entertainment module lib (ENABLED list, scheduler sync)\n57: │\n58: ├── bin/                    # CLI tools — installed to /usr/local/bin/\n59: │   ├── pos                 # Main dispatcher — smart arg matching to pos-* scripts\n60: <!-- GEN:START tree -->\n61: │   ├── pos-ai-gemini                       # Chat with Google Gemini (ask, chat, models, sessions)\n62: │   ├── pos-communication-matrix-listener   # Matrix listener: map /command → bash, run them on room messages\n63: │   ├── pos-communication-matrix-sender     # Send messages to a Matrix room via the client-server API (send, test, login)\n64: │   ├── pos-communication-telegram-listener # Telegram bot listener: map /command → bash, run them on chat messages\n65: │   ├── pos-communication-telegram-sender   # Send Telegram messages/files/links/stickers via Bot API (send, test)\n66: │   ├── pos-config                          # Interactive editor for the tools' runtime config (reads # POS_CONFIG: registry)\n67: │   ├── pos-docker-compose                  # Docker Compose service manager (ls/up/down/restart/logs/update/config)\n68: │   ├── pos-docker-health                   # One-glance container health dashboard (exits 1 if unhealthy)\n69: │   ├── pos-docker-ps                       # Enhanced container overview (health, IPs, ports, uptime)\n70: │   ├── pos-docker-vbox                     # Disposable Docker-based VMs (create/enter/start/stop/rm/ls)\n71: │   ├── pos-entertainment-config            # Show or edit the entertainment config (ENABLED auto-trigger list, weather location)\n72: │   ├── pos-entertainment-disable           # Disable a plugin's auto-trigger (remove it from ENABLED)\n73: │   ├── pos-entertainment-enable            # Enable an auto-trigger for a plugin on a schedule\n74: │   ├── pos-entertainment-send              # Run a public-API plugin and send its output via Telegram (default sender)\n75: │   ├── pos-entertainment-status            # Show enabled plugins and scheduler state\n76: │   ├── pos-media-mp3                       # Download audio as MP3 (yt-dlp)\n77: │   ├── pos-media-mp4                       # Download video as MP4 (smart/interactive format select)\n78: │   ├── pos-network-checkport               # Check TCP/UDP port reachability (nmap, or bash/nc fallback) + local interface view\n79: │   ├── pos-network-download                # aria2 RPC daemon + queue control (add/torrent/metalink, watch, limits)\n80: │   ├── pos-network-hotspot                 # Wi-Fi hotspot via create_ap + wihotspot-gui\n81: │   ├── pos-network-ip                      # Show interfaces, routes, public IP + location\n82: │   ├── pos-network-scan                    # Parallel ping sweep of CIDR\n83: │   ├── pos-share-nfs-client                # Mount NFS shares (ephemeral or persistent systemd mount units)\n84: │   ├── pos-share-nfs-server                # Manage the NFS kernel server (status, share/unshare exports, enable/disable)\n85: │   ├── pos-share-smb-client                # Mount SMB/CIFS shares (ephemeral or persistent systemd mount units)\n86: │   ├── pos-share-smb-server                # Manage the Samba server (status, share/unshare exports, users, enable/disable)\n87: │   ├── pos-share-usb-server                # USB Redirector server control (--ls, --share; prompts when args omitted)\n88: │   ├── pos-ssh-load-keys                   # Load all SSH keys into the agent\n89: │   ├── pos-system-backup                   # Encrypted (AES-256) folder snapshots (tar + gpg)\n90: │   ├── pos-system-event-trigger            # State-based rule monitors; alerts via notify when a check crosses a threshold\n91: │   ├── pos-system-firewall                 # Interactive UFW management\n92: │   ├── pos-system-health                   # Host health dashboard (disk, RAM, services, backup age, fail2ban, docker); exit 1 if any FAIL\n93: │   ├── pos-tree                            # Show the pos CLI command tree: categories, commands, and subcommands\n94: <!-- GEN:END tree -->\n95: │   ├── flag-reader         # Inspect feature flags (list/status/--raw)\n96: │   ├── flag-set            # Set a feature flag (optionally with a value)\n97: │   ├── flag-clear          # Unset a feature flag\n98: │   ├── wr-*                # Legacy wrappers → pos (backward compat)\n99: │   ├── mp3, mp4, vbox      # Legacy convenience wrappers → pos\n100: │   └── ssh-load-all        # Legacy wrapper → pos ssh load-keys\n101: │\n102: ├── features/               # User-customizable scripts (installed via --feature)\n103: │   └── autostart.sh        # Boot-time script (via systemd, flag-gated)\n104: │\n105: ├── entertainment/          # Public-API plugins for pos entertainment send (→ /usr/local/bin)\n106: │   ├── weather.sh          # Current weather via Open-Meteo (no API key)\n107: │   ├── joke.sh             # Random dad joke via icanhazdadjoke (no API key)\n108: │   └── gold.sh             # Gold spot (XAU/USD) via goldprice.dev (no API key)\n109: │\n110: ├── templates/              # Dev-only scaffolds — NOT installed by install.sh\n111: │   ├── pos-tool.sh         # New `pos` CLI tool (→ bin/pos-<cat>-<cmd>)\n112: │   ├── app.sh              # New optional app installer (→ apps/<cat>/<name>.sh)\n113: │   └── feature.sh          # New feature script (→ features/<name>.sh)\n114: │\n115: ├── x64_bin/                # Precompiled binaries