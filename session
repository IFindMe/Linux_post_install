ho \"daemon:     not running\"; fi\n    if systemctl --user is-enabled \"$SERVICE\" >/dev/null 2>&1; then\n        echo \"autostart:  enabled (starts on login)\"\n    else\n        echo \"autostart:  disabled\"\n    fi\n    echo \"rpc:        http://127.0.0.1:$RPC_PORT\"\n    [ -f \"$CONFIG_FILE\" ] && echo \"secret:     $CONFIG_FILE\"\n    echo \"dir:        $DOWNLOAD_DIR\"\n    if daemon_active; then\n        local g v\n        g=$(rpc aria2.getGlobalStat)\n        echo \"$g\" | jq -r '\"active: \\(.result.numActive)   waiting: \\(.result.numWaiting)   stopped: \\(.result.numStopped)   (history: \\(.result.numStoppedTotal))\"'\n        g=$(rpc aria2.getVersion)\n        v=$(echo \"$g\" | jq -r '.result.version')\n        echo \"aria2:      $v\"\n    fi\n}\n```\n\ncmd_list:\n```bash\ncmd_list() {\n    local act wait stp\n    act=$(rpc aria2.tellActive)\n    wait=$(rpc aria2.tellWaiting 0 100)\n    stp=$(rpc aria2.tellStopped 0 50)\n    printf 'ACTIVE (%s)\\n' \"$(printf '%s' \"$act\" | jq '.result | length')\"\n    rows_of \"$act\" | fmt_list\n    ...\n}\n```\nHmm — separate headers with counts:\n```bash\n    local n\n    n=$(printf '%s' \"$act\" | jq '.result | length')\n    printf 'ACTIVE %s\\n' \"$n\"\n    printf '%s' \"$act\" | jq -r \"$LIST_JQ\" | fmt_list\n```\nLet me define LIST_JQ once:\n```bash\nLIST_JQ='.result[] | [.gid[0:8], .status,\n (if ((.totalLength|tonumber) > 0) then (100*(.completedLength|tonumber)/(.totalLength|tonumber)) else 0 end),\n (.downloadSpeed|tonumber), (.uploadSpeed|tonumber),\n (.bittorrent.info.name // ((.files[0].path // \"\")|split(\"/\")|last))] | @tsv'\n```\nWait `.bittorrent.info.name // ...` — if .bittorrent missing, `(.bittorrent.info.name)` errors? In jq, `.bittorrent.info.name` on missing → null (no error) as long as `.bittorrent` is null → `.info` on null → null. `//` alternation handles null. OK.\n\nfmt_list:\n```bash\nfmt_list() {\n    awk -F'\\t' \"$ROW_AWK\" '{ printf \"  %-8s %-9s %6.1f%% %9s %9s %s\\n\", $1, $2, $3,