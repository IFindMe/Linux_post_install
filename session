R_SYSTEMD_DIR\"\n545:     local runner\n546:     if [ -x /usr/local/bin/pos-network-download ]; then\n547:         runner=/usr/local/bin/pos-network-download\n548:     else\n549:         runner=\"$(cd \"$(dirname \"$0\")/..\" && pwd)/bin/pos-network-download\"\n550:         warn \"using repo path $runner — re-run 'install.sh' so the healer survives a deleted repo\"\n551:     fi\n552:     if [ \"${DRY_RUN:-0}\" -eq 1 ]; then\n553:         log \"(dry-run) install $HEALER_SERVICE + $HEALER_TIMER in $USER_SYSTEMD_DIR\"\n554:         return 0\n555:     fi\n556:     cat > \"$USER_SYSTEMD_DIR/$HEALER_SERVICE\" <<EOF\n557: [Unit]\n558: Description=pos aria2 retry healer (linux-post-install)\n559: \n560: [Service]\n561: Type=oneshot\n562: Environment=PATH=/usr/local/bin:/usr/bin:/bin\n563: ExecStart=$runner retry all --once --quiet\n564: EOF\n565:     chmod 644 \"$USER_SYSTEMD_DIR/$HEALER_SERVICE\"\n566:     cat > \"$USER_SYSTEMD_DIR/$HEALER_TIMER\" <<EOF\n567: [Unit]\n568: Description=pos aria2 retry healer timer (linux-post-install)\n569: \n570: [Timer]\n571: OnUnitActiveSec=2min\n572: OnBootSec=2min\n573: AccuracySec=30s\n574: Persistent=true\n575: \n576: [Install]\n577: WantedBy=timers.target\n578: EOF\n579:     chmod 644 \"$USER_SYSTEMD_DIR/$HEALER_TIMER\"\n580:     systemctl --user daemon-reload\n581: }\n582: \n583: ensure_healer() {\n584:     # Arm the retry timer whenever a download starts; it heals failed downloads.\n585:     if ! systemctl --user is-enabled \"$HEALER_TIMER\" >/dev/null 2>&1; then\n586:         install_healer_units\n587:         if [ \"${DRY_RUN:-0}\" -eq 1 ]; then\n588:             log \"(dry-run) systemctl --user enable --now $HEALER_TIMER\"\n589:         else\n590:             systemctl --user enable --now \"$HEALER_TIMER\" >/dev/null 2>&1 \\\n591:                 || warn \"could not enable retry healer ($HEALER_TIMER)\"\n592:             log \"retry healer armed — failed downloads auto-retry every 2 min\"\n593:         fi\n594:     fi\n595: }\n596: \n597: healer_done() {\n598:     # Disable the timer when nothing is left to heal (no active/waiting/errored).\n599:     [ -f \"$USER_SYSTEMD_DIR/$HEALER_TIMER\" ] || return 0\n600:     local n\n601:     n=$(rpc aria2.tellActive | jq '.result | length')\n602:     [ \"$n\" -gt 0 ] && return 0\n603:     n=$(rpc aria2.tellWaiting 0 200 | jq '.result | length')\n604:     [ \"$n\" -gt 0 ] && return 0\n605:     n=$(rpc aria2.tellStopped 0 200 | jq '[.result[] | select(.status == \"error\")] | length')\n606:     [ \"$n\" -gt 0 ] && return 0\n607:     if [ \"${DRY_RUN:-0}\" -eq 1 ]; then\n608:         log \"(dry-run) systemctl --user disable --now $HEALER_TIMER\"\n609:     else\n610:         systemctl --user disable --now \"$HEALER_TIMER\" >/dev/null 2>&1 || true\n611:         log \"retry healer disabled — no active or failed downloads left\"\n612:     fi\n613: }\n614: \n615: # ── Listing / inspection ───────────────────────────────────────\n616: LIST_JQ='.result[] | [.gid[0:8], .status,\n617:  (if ((.totalLength|tonumber) > 0) then (100*(.completedLength|tonumber)/(.totalLength|tonumber)) else 0 end),\n618:  (.downloadSpeed|tonumber), (.uploadSpeed|tonumber),\n619:  (.bittorrent.info.name // ((.files[0].path // \"\")|split(\"/\")|last))] | @tsv'\n620: \n621: fmt_list() {\n622:     awk -F'\\t' \"$ROW_AWK\"'{ printf \"  %-8s %-9s %6.1f%% %9s %9s %s\\n\", $1, $2, $3, hs($4), hs($5), $6 }'\n623: }\n624: \n625: cmd_list() {\n626:     local act wait stp n\n627:     act=$(rpc aria2.tellActive)\n628:     wait=$(rpc aria2.tellWaiting 0 100)\n629:     stp=$(rpc aria2.tellStopped 0 50)\n630:     n=$(printf '%s' \"$act\" | jq '.result | length')\n631:     printf 'ACTIVE (%s)\\n' \"$n\"\n632:     printf '  %-8s %-9s %7s %9s %9s %s\\n' GID STATUS PCT DL UL NAME\n633:     printf '%s' \"$act\" | jq -r \"$LIST_JQ\" | fmt_list\n634:     n=$(printf '%s' \"$wait\" | jq '.result | length')\n635:     printf 'WAITING (%s)\\n' \"$n\"\n636:     printf '  %-8s %-9s %7s %9s %9s %s\\n' GID STATUS