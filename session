              "content": "# lib/ui.sh — interactive UI helpers (gum-backed with a plain-bash fallback).\n#\n# The repo's ONE interactive-UI layer (see DEV.md \"Interactive UI\n# Convention\"). Tools call ui_*; they never inline raw read/printf menus.\n#\n#   POS_UI=auto|gum|plain   backend selection\n#     auto   gum when available AND stdin is a TTY, else plain (default)\n#     gum    force gum\n#     plain  force the plain fallback (tests, minimal boxes, cron/systemd)\n#   POS_GUM=<path>          override the gum binary (stub seam for tests)\n#\n# Contracts (both backends behave identically):\n#   * Prompts and menus render to stderr; the chosen VALUE prints on stdout,\n#     so callers capture with $(...) without prompt noise.\n#   * Uniform keys: Enter = keep/confirm, '-' = clear, q = quit/abort.\n#   * Abort (q/Esc/EOT) prints nothing and returns non-zero. A valid but\n#     empty result (e.g. an empty multiselect) prints nothing with rc 0.\n#   * ui_typed() is the type -> control dispatch table:\n#     bool -> ui_confirm, enum(a,b,c) -> ui_choose, list -> ui_multiselect,\n#     secret -> hidden input, digits|num|float -> validated input, else text.\n#\n# Sourced after lib/common.sh (uses warn()); same source guard.\n\n# True when the gum backend is active for this invocation.\n_ui_gum_available() {\n    local have_gum=0\n    if [ -n \"${POS_GUM:-}\" ]; then\n        [ -x \"${POS_GUM:-}\" ] && have_gum=1\n    else\n        command -v gum >/dev/null 2>&1 && have_gum=1\n    fi\n    case \"${POS_UI:-auto}\" in\n        plain) return 1 ;;\n        gum)   [ \"$have_gum\" -eq 1 ] ;;\n        auto)  [ \"$have_gum\" -eq 1 ] && [ -t 0 ] ;;\n        *)     warn \"unknown POS_UI '${POS_UI}' (auto|gum|plain) — falling back to plain\" >&2; return 1 ;;\n    esac\n}\n\n# Run gum (or the POS_GUM stub) with the given args.\n_ui_gum_run() {\n    if [ -n \"${POS_GUM:-}\" ]; then\n        \"${POS_GUM}\" \"$@\"\n    else\n        gum \"$@\"\n    fi\n}\n\n# ui_choose <prompt> <option> [option...] -> prints the chosen option.\nui_choose() {\n    local prompt=\"$1\"; shift\n    local -a opts=(\"$@\")\n    [ \"${#opts[@]}\" -gt 0 ] || { warn \"ui_choose: no options given\" >&2; return 1; }\n    local sel\n    if _ui_gum_available; then\n        sel=\"$(_ui_gum_run choose --header \"$prompt\" \"${opts[@]}\")\" || return 1\n        printf '%s\\n' \"$sel\"\n    else\n        _ui_plain_choose \"$prompt\" \"${opts[@]}\"\n    fi\n}\n\n# ui_multiselect <prompt> <option> [option...] -> prints the comma-joined\n# selection on stdout (empty string when nothing is selected, rc 0).\nui_multiselect() {\n    local prompt=\"$1\"; shift\n    local -a opts=(\"$@\")\n    [ \"${#opts[@]}\" -gt 0 ] || { warn \"ui_multiselect: no options given\" >&2; return 1; }\n    local sel\n    if _ui_gum_available; then\n        sel=\"$(_ui_gum_run choose --multi --no-limit --header \"$prompt\" \"${opts[@]}\")\" || return 1\n        printf '%s\\n' \"$sel\" | paste -sd, -\n    else\n        _ui_plain_multiselect \"$prompt\" \"${opts[@]}\"\n    fi\n}\n\n# ui_input <prompt> [default] [secret] -> prints the entered value on stdout.\n# Enter with no input returns the default; rc 1 on abort (Esc/EOT).\nui_input() {\n    local prompt=\"$1\" default=\"${2:-}\" secret=\"${3:-}\" val\n    if _ui_gum_available; then\n        if [ \"$secret\" = \"1\" ]; then\n            val=\"$(_ui_gum_run input --password --prompt \"$prompt: \" --placeholder \"$default\")\" || return 1\n        else\n            val=\"$(_ui_gum_run input --prompt \"$prompt: \" --value \"$default\" --placeholder \"$default\")\" || return 1\n        fi\n        printf '%s\\n' \"$val\"\n    else\n        if [ \"$secret\" = \"1\" ]; then\n            read -rsp \"${prompt}: \" val >&2 || return 1\n            echo >&2\n        else\n            read -rp \"${prompt}${default:+ [${default}]}: \" val >&2 || return 1\n        fi\n        [ -n \"$val\" ] || val=\"$default\"\n        printf '%s\\n' \"$val\"\n    fi\n}\n\n# ui_confirm <prompt> [y|n] -> rc 0 = yes, rc 1 = no (no stdout output).\nui_confirm() {\n    local prompt=\"$1\" default=\"${2:-n}\"\n    if _ui_gum_available; then\n        local def=false\n        [ \"$default\" = \"y\" ] && def=true\n        _ui_gum_run confirm \"$prompt\" --default=\"$def\" --affirmative \"Yes\" --negative \"No\"\n    else\n        confirm \"$prompt\" \"$default\"\n    fi\n}\n\n# ui_header <title> -> styled banner on stderr.\nui_header() {\n    local title=\"$*\"\n    if _ui_gum_available; then\n        _ui_gum_run style --border rounded --padding \"0 1\" --foreground 214 \"$title\" >&2\n    else\n        printf '\\n  -- %s --\\n' \"$title\" >&2\n    fi\n}\n\n# ── Plain (no-gum) fallbacks ─────────────────────────────────────\n\n_ui_plain_choose() {\n    local prompt=\"$1\"; shift\n    local -a opts=(\"$@\")\n    local i ans\n    printf '%s\\n' \"$prompt\" >&2\n    for ((i = 0; i < ${#opts[@]}; i++)); do\n        printf '  %2d) %s\\n' \"$((i + 1))\" \"${opts[i]}\" >&2\n    done\n    read -rp \"Choice [1-${#opts[@]}], q to quit: \" ans >&2 || return 1\n    case \"$ans\" in\n        q|Q|$'\\e') return 1 ;;\n    esac\n    if [[ \"$ans\" =~ ^[0-9]+$ ]] && (( ans >= 1 && ans <= ${#opts[@]} )); then\n        printf '%s\\n' \"${opts[ans - 1]}\"\n    else\n        warn \"invalid choice '$ans'\" >&2\n        return 1\n    fi\n}\n\n_ui_plain_multiselect() {\n    local prompt=\"$1\"; shift\n    local -a opts=(\"$@\")\n    local i ans out=\"\"\n    printf '%s (y = include, n = skip, q = quit)\\n' \"$prompt\" >&2\n    for ((i = 0; i < ${#opts[@]}; i++)); do\n        read -rp \"  ${opts[i]}? [y/N]: \" ans >&2 || return 1\n        case \"$ans\" in\n            q|Q|$'\\e') return 1 ;;\n        esac\n        if [[ \"$ans\" =~ ^[Yy] ]]; then\n            [ -n \"$out\" ] && out+=\",\"\n            out+=\"${opts[i]}\"\n        fi\n    done\n    printf '%s\\n' \"$out\"\n}\n\n# ── Validated number input (digits|num|float) ────────────────────\n\nui_validate_num() {\n    local kind=\"$1\" prompt=\"$2\" current=\"$3\" val re\n    case \"$kind\" in\n        digits) re='^-?[0-9]+$' ;;\n        num)    re='^-?[0-9]+$' ;;\n        float)  re='^-?[0-9]+([.][0-9]+)?$' ;;\n        *)      re='.*' ;;\n    esac\n    while true; do\n        val=\"$(ui_input \"$prompt\" \"$current\")\" || return 1\n        [ -z \"$val\" ] && return 1\n        [ \"$val\" = \"-\" ] && { printf '%s\\n' \"$val\"; return 0; }\n        [[ \"$val\" =~ $re ]] && { printf '%s\\n' \"$val\"; return 0; }\n        warn \"not a valid $kind ('$val') — try again\" >&2\n    done\n}\n\n# ── Type -> control dispatch ─────────────────────────────────────\n\n# ui_typed <flags> <prompt> <current> [options...] -> prints the edited\n# value on stdout (rc 1 on abort). For 'list' the options are required.\nui_typed() {\n    local flags=\"$1\" prompt=\"$2\" current=\"$3\"; shift 3\n    local -a opts=(\"$@\")\n    local f flag=\"\"\n    for f in $flags; do\n        case \"$f\" in\n            bool|secret|digits|num|float|list|enum*) flag=\"$f\"; break ;;\n        esac\n    done\n    case \"$flag\" in\n        bool)\n            if ui_confirm \"$prompt\" \"${current:-n}\"; then printf 'true\\n'; else printf 'false\\n'; fi ;;\n        secret)  ui_input \"$prompt\" \"$current\" 1 ;;\n        digits|num|float) ui_validate_num \"$flag\" \"$prompt\" \"$current\" ;;\n        enum*)   ui_enum \"$flag\" \"$prompt\" \"$current\" ;;\n        list)    ui_multiselect \"$prompt\" \"${opts[@]}\" ;;\n        *)       ui_input \"$prompt\" \"$current\" ;;\n    esac\n}\n\n# enum(a,b,c) -> single choice from the comma-separated options.\nui_enum() {\n    local flag=\"$1\" prompt=\"$2\" current=\"$3\"\n    local list=\"${flag#enum(}\"; list=\"${list%)}\"\n    local -a iopts=() eopts=()\n    IFS=',' read -r -a iopts <<<\"$list\"\n    for o in \"${iopts[@]}\"; do\n        eopts+=(\"${o// /}\")\n    done\n    ui_choose \"${prompt} (current: ${current:-not set})\" \"${eopts[@]}\"\n}\n\nreturn 0 2>/dev/null || true\n",
