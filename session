ux &>/dev/null || err \"tmux not found (install tmux) — needed for --tmux\"; }\n282:     dir=\"${dir/#\\~/$HOME}\"\n283:     ensure_daemon\n284:     local item\n285:     for item in \"${items[@]}\"; do\n286:         local resp gid name\n287:         if [[ \"$item\" =~ ^magnet: ]]; then\n288:             resp=$(rpc aria2.addUri \"$(json_arr \"$item\")\" \"$(opts_json \"dir=$dir\")\")\n289:             name=\"magnet\"\n290:         else\n291:             [ -f \"$item\" ] || err \"torrent: no such file: $item\"\n292:             name=$(basename \"$item\"); name=\"${name%.torrent}\"\n293:             resp=$(rpc aria2.addTorrent \"$(json_str \"$(base64 -w0 \"$item\")\")\" \"[]\" \"$(opts_json \"dir=$dir\")\")\n294:         fi\n295:         gid=$(printf '%s' \"$resp\" | jq -r '.result')\n296:         if [ \"$seed\" -eq 1 ]; then\n297:             rpc aria2.changeOption \"$(json_str \"$gid\")\" \"$(opts_json \"seed-ratio=0\")\" >/dev/null\n298:             log \"added torrent $gid: $item (seeding until stopped)\"\n299:         else\n300:             log \"added torrent $gid: $item\"\n301:         fi\n302:         if [ \"$tmux\" -eq 1 ]; then tmux_watch \"$gid\" \"$name\"; fi\n303:     done\n304: }\n305: \n306: cmd_metalink() {\n307:     local dir=\"$DOWNLOAD_DIR\" tmux=0 item=\"\"\n308:     while [ $# -gt 0 ]; do\n309:         case \"$1\" in\n310:             --dir)   dir=\"${2:-$DOWNLOAD_DIR}\"; shift 2 ;;\n311:             --dir=*) dir=\"${1#*=}\"; shift ;;\n312:             --tmux)  tmux=1; shift ;;\n313:             -h|--help) usage ;;\n314:             -*) err \"metalink: unknown option: $1\" ;;\n315:             *) item=\"$1\"; shift ;;\n316:         esac\n317:     done\n318:     [ -n \"$item\" ] || err \"metalink: need a .metalink file or URL\"\n319:     [ \"$tmux\" -eq 1 ] && { command -v tmux &>/dev/null || err \"tmux not found (install tmux) — needed for --tmux\"; }\n320:     dir=\"${dir/#\\~/$HOME}\"\n321:     ensure_daemon\n322:     local src=\"$item\" name\n32