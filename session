              "file": "bin/pos-menu",
              "patch": "Index: bin/pos-menu\n===================================================================\n--- bin/pos-menu\t\n+++ bin/pos-menu\t\n@@ -1,158 +1,159 @@\n #!/usr/bin/env bash\n set -euo pipefail\n # POS: menu — Interactive navigator over the whole pos CLI (category → tool → guided / bare run / help)\n # POS_FLAGS: --dry-run\n \n source \"$(dirname \"$0\")/../lib/common.sh\" 2>/dev/null || source \"$(dirname \"$0\")/common.sh\"\n source \"$(dirname \"$0\")/../lib/ui.sh\" 2>/dev/null || source \"$(dirname \"$0\")/ui.sh\"\n \n usage() {\n     cat <<EOF\n Usage: pos menu [--dry-run]\n \n Interactive navigator over the whole pos CLI: pick a category, then a tool,\n then run it guided (prompted per '# POS_FLAGS:' flag), run it bare (its own\n interactive mode), or show its help. 'q'/Esc always steps back / quits.\n \n   --dry-run  Print the command that would run instead of running it (test seam)\n \n Derived live from the bin/pos-* files (like 'pos tree'); no hardcoded list.\n EOF\n     exit 0\n }\n \n # ── Structure (live from bin/pos-*) ─────────────────────────────\n \n # \"category|toolfile\" per executable tool (pos-menu and the dispatcher\n # excluded; category-less tools land in \"(root)\").\n _menu_entries() {\n     local dir=\"$1\" f base words cat\n     for f in \"$dir\"/pos-*; do\n         [ -x \"$f\" ] || continue\n         base=\"${f##*/}\"\n         case \"$base\" in\n             pos|pos-menu) continue ;;\n         esac\n         words=\"${base#pos-}\"\n         if [[ \"$words\" == *-* ]]; then\n             cat=\"${words%%-*}\"\n         else\n             cat=\"(root)\"\n         fi\n         printf '%s|%s\\n' \"$cat\" \"$base\"\n     done\n }\n \n _categories() {\n     local dir=\"$1\"\n     echo \"(root)\"\n     _menu_entries \"$dir\" | cut -d'|' -f1 | grep -v '^(root)$' | sort -u\n }\n \n _tools_in() {\n     local dir=\"$1\" cat=\"$2\" line c\n     while IFS= read -r line; do\n         c=\"${line%%|*}\"\n         [ \"$c\" = \"$cat\" ] && echo \"${line#*|}\"\n     done < <(_menu_entries \"$dir\")\n }\n \n # Command words + one-line description of a tool file.\n _tool_words() { local base=\"$1\"; echo \"${base#pos-}\"; }\n _tool_desc() {\n-    sed -n '/^# POS: /{s/^# POS: //;p;q}' \"$1\" 2>/dev/null \\\n-        | cut -d'—' -f2- | sed 's/^[[:space:]]*//' || true\n+    # Pure sed (no cut): the '—' separator is multi-byte UTF-8 and cut\n+    # rejects it as a delimiter under C/POSIX locales.\n+    sed -n '/^# POS: /{s/^# POS: [^—]*— //;p;q}' \"$1\" 2>/dev/null || true\n }\n _pos_flags() {\n     sed -n '/^# POS_FLAGS:/{s/^# POS_FLAGS:[[:space:]]*//;p;q}' \"$1\" 2>/dev/null || true\n }\n \n # ── Running ─────────────────────────────────────────────────────\n \n _dispatcher() {\n     command -v pos 2>/dev/null || echo \"$(dirname \"$0\")/pos\"\n }\n \n # Run (or print, with --dry-run) the tool as 'pos <words> [args...]'.\n _run_tool() {\n     local base=\"$1\" dry=\"$2\"; shift 2\n     local words\n     words=\"$(_tool_words \"$base\")\"\n     if [ \"$dry\" -eq 1 ]; then\n         printf 'pos %s' \"$words\"\n         for a in \"$@\"; do printf ' %s' \"$a\"; done\n         printf '\\n'\n     else\n         \"$(_dispatcher)\" $words \"$@\" || true\n     fi\n }\n \n # ── Screens ─────────────────────────────────────────────────────\n \n # Guided run: prompt per '# POS_FLAGS:' flag. Boolean flags (--no-*) are a\n # yes/no include; everything else asks for a value (Enter = bare flag).\n _guided() {\n     local tool=\"$1\" base=\"$2\" dry=\"$3\"\n     local fl flag\n     fl=\"$(_pos_flags \"$tool\")\"\n     local -a args=()\n     for flag in $fl; do\n         if [[ \"$flag\" == --no-* ]]; then\n             if ui_confirm \"Include $flag?\" n; then\n                 args+=(\"$flag\")\n             fi\n         else\n             local v\n             if ui_confirm \"Include $flag?\" n; then\n                 v=\"$(ui_input \"Value for $flag (Enter = bare flag)\" \"\")\" || return 1\n                 if [ -n \"$v\" ]; then\n                     args+=(\"$flag\" \"$v\")\n                 else\n                     args+=(\"$flag\")\n                 fi\n             fi\n         fi\n     done\n     _run_tool \"$base\" \"$dry\" \"${args[@]}\"\n }\n \n _tool_screen() {\n     local dir=\"$1\" base=\"$2\" dry=\"$3\"\n     local tool=\"$dir/$base\" desc\n     desc=\"$(_tool_desc \"$tool\")\"\n     local action\n     ui_header \"pos $(_tool_words \"$base\")${desc:+ — ${desc}}\"\n     action=\"$(ui_choose \"Action\" \"Run guided\" \"Run bare (no args)\" \"Help\" \"← Back\")\" || return 0\n     case \"$action\" in\n         \"Run guided\")      _guided \"$tool\" \"$base\" \"$dry\" ;;\n         \"Run bare (no args)\") _run_tool \"$base\" \"$dry\" ;;\n         \"Help\")            _run_tool \"$base\" \"$dry\" --help ;;\n         *)                 return 0 ;;\n     esac\n     return 0\n }\n \n menu() {\n     local dir=\"$1\" dry=\"$2\"\n     local -a cats=() tools=()\n     local cat base\n     mapfile -t cats < <(_categories \"$dir\")\n     while true; do\n         ui_header \"pos menu\"\n         cat=\"$(ui_choose \"Category\" \"${cats[@]}\")\" || { echo; return 0; }\n         tools=()\n         mapfile -t tools < <(_tools_in \"$dir\" \"$cat\")\n         if [ ${#tools[@]} -eq 0 ]; then\n             warn \"no tools in '$cat'\"\n             continue\n         fi\n         base=\"$(ui_choose \"Tool in '${cat}'\" \"${tools[@]}\")\" || continue\n         _tool_screen \"$dir\" \"$base\" \"$dry\"\n     done\n }\n \n case \"${1:-}\" in\n     -h|--help) usage ;;\n     --dry-run) menu \"$(dirname \"$0\")\" 1 ;;\n     *)         menu \"$(dirname \"$0\")\" 0 ;;\n esac\n",
              "additions": 3,
              "deletions": 2,
              "status": "modified"
