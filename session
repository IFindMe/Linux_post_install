   ;;\n465:         esac\n466:     done\n467:     [ \"$quiet\" -eq 1 ] || warn \"retry of ${RESTART_NAME:-$g} did not stabilize after 5 checks\"\n468:     return 1\n469: }\n470: \n471: cmd_retry() {\n472:     local target=\"all\" interval=\"$RETRY_INTERVAL\" maxwait=0 once=0 quiet=0\n473:     local rdir=\"\" rsplit=\"\" seed=0 tmux=0 rargs=() gids=() gid st failures=0 ng newgids src deadline=0\n474:     while [ $# -gt 0 ]; do\n475:         case \"$1\" in\n476:             --interval)  interval=\"${2:-30}\"; shift 2 ;;\n477:             --interval=*) interval=\"${1#*=}\"; shift ;;\n478:             --max-wait)  maxwait=\"${2:-0}\"; shift 2 ;;\n479:             --max-wait=*) maxwait=\"${1#*=}\"; shift ;;\n480:             --once)  once=1; shift ;;\n481:             --quiet) quiet=1; shift ;;\n482:             --dir)   rdir=\"${2:-}\"; shift 2 ;;\n483:             --dir=*) rdir=\"${1#*=}\"; shift ;;\n484:             --seed)  seed=1; shift ;;\n485:             --split) rsplit=\"${2:-}\"; shift 2 ;;\n486:             --split=*) rsplit=\"${1#*=}\"; shift ;;\n487:             --tmux)  tmux=1; shift ;;\n488:             -h|--help) usage ;;\n489:             -*) err \"retry: unknown option: $1\" ;;\n490:             *) target=\"$1\"; shift ;;\n491:         esac\n492:     done\n493:     if ! daemon_active; then\n494:         [ \"$quiet\" -eq 1 ] && return 0\n495:         err \"daemon not running — start it first (pos network download start)\"\n496:     fi\n497:     rdir=\"${rdir/#\\~/$HOME}\"\n498:     [ \"$tmux\" -eq 1 ] && { command -v tmux &>/dev/null || err \"tmux not found (install tmux) — needed for --tmux\"; }\n499:     [ -n \"$rdir\" ] && rargs+=(--dir \"$rdir\")\n500:     [ \"$seed\" -eq 1 ] && rargs+=(--seed)\n501:     [ -n \"$rsplit\" ] && rargs+=(--split \"$rsplit\")\n502:     [ \"$tmux\" -eq 1 ] && rargs+=(--tmux)\n503:     if [ \"$target\" = \"all\" ]; then\n504:         mapfile -t gids < <(rpc aria2.tellStopped 0 200 | jq -r '.result[] | select(.status == \"er