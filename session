\n361: do_restart() {  # do_restart <gid> <dir> <seed 0|1> <split> → prints new gids; sets RESTART_NAME\n362:     local gid=\"$1\" dir=\"$2\" seed=\"$3\" split=\"$4\"\n363:     local data st is_bt name=\"\" newgids=() uri fdir fname oa ng d magnet\n364:     data=$(rpc aria2.tellStatus \"$(json_str \"$gid\")\")\n365:     st=$(printf '%s' \"$data\" | jq -r '.result.status')\n366:     case \"$st\" in\n367:         complete|error|removed) ;;\n368:         active) err \"gid $gid is active — it's already downloading\" ;;\n369:         *) err \"gid $gid has status '$st' — cannot restart\" ;;\n370:     esac\n371:     is_bt=$(printf '%s' \"$data\" | jq -r 'if .result.bittorrent then 1 else 0 end')\n372:     name=$(printf '%s' \"$data\" | jq -r '(.result.bittorrent.info.name // (.result.files[0].path // \"\")) | split(\"/\") | last')\n373:     [ -n \"$name\" ] || name=\"download\"\n374:     RESTART_NAME=\"$name\"\n375:     if [ \"$is_bt\" = \"1\" ]; then\n376:         magnet=$(printf '%s' \"$data\" | jq -r '.result.bittorrent as $b | \"magnet:?xt=urn:btih:\\($b.infoHash)\" + (($b.announceList // []) | flatten | map(\"&tr=\" + @uri) | join(\"\"))')\n377:         d=\"${dir:-$(printf '%s' \"$data\" | jq -r '.result.dir')}\"; d=\"${d/#\\~/$HOME}\"\n378:         oa=()\n379:         [ -n \"$d\" ] && oa+=(\"dir=$d\")\n380:         [ -n \"$split\" ] && oa+=(\"split=$split\")\n381:         ng=$(rpc aria2.addUri \"$(json_arr \"$magnet\")\" \"$(opts_json \"${oa[@]}\")\" | jq -r '.result')\n382:         newgids+=(\"$ng\")\n383:         if [ \"$seed\" -eq 1 ]; then\n384:             rpc aria2.changeOption \"$(json_str \"$ng\")\" \"$(opts_json \"seed-ratio=0\")\" >/dev/null\n385:         fi\n386:     else\n387:         while IFS=$'\\t' read -r uri fdir fname; do\n388:             [ -n \"$uri\" ] || continue\n389:             oa=()\n390:             [ -n \"$fdir\" ] && oa+=(\"dir=$fdir\")\n391:             [ -n \"$fname\" ] && oa+=(\"out=$fname\")\n392:             [ -n \"$split\" ] && oa+=