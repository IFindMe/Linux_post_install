bled \"$cur\"\n        pairs=(\"${ENABLED_ENTRIES[@]}\")\n    fi\n    local entry p iv\n    for entry in \"${pairs[@]}\"; do\n        p=\"${entry%%,*}\"; iv=\"${entry##*,}\"\n        [ \"$iv\" = \"$p\" ] && iv=\"$DEFAULT_INTERVAL\"\n        existing[$p]=\"$iv\"\n    done\n\n    local sel\n    sel=\"$(ui_multiselect \"Auto-trigger plugins (current: ${cur:-none})\" \"${plugins[@]}\")\" || return 1\n\n    local -a chosen=() out=()\n    if [ -n \"$sel\" ]; then\n        IFS=',' read -r -a chosen <<<\"$sel\"\n    fi\n    local c\n    for c in \"${chosen[@]}\"; do\n        c=\"${c// /}\"\n        if [ -n \"${existing[$c]:-}\" ]; then\n            out+=(\"$c,${existing[$c]}\")\n        else\n            iv=\"$(ui_input \"Interval for '$c' (default ${DEFAULT_INTERVAL})\" \"$DEFAULT_INTERVAL\")\" || return 1\n            [ -n \"$iv\" ] || iv=\"$DEFAULT_INTERVAL\"\n            if ! interval_to_oncalendar \"$iv\" >/dev/null 2>&1; then\n                warn \"invalid interval '$iv' — using $DEFAULT_INTERVAL\"\n                iv=\"$DEFAULT_INTERVAL\"\n            fi\n            out+=(\"$c,$iv\")\n        fi\n    done\n\n    local rendered\n    rendered=\"$(render_enabled \"${out[@]}\")\"\n    if [ \"$rendered\" = \"$cur\" ]; then\n        log \"ENABLED unchanged (${cur:-empty})\"\n        return 0\n    fi\n    write_config_key ENABLED \"$rendered\"\n    ok \"ENABLED = ${rendered:-<empty>} — schedule synced\"\n    sync_timers\n}",
