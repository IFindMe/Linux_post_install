#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
Usage: pos media mp3 <url>

Download audio from a URL and convert to MP3 via yt-dlp.

Examples:
  pos media mp3 https://youtube.com/watch?v=dQw4w9WgXcQ
EOF
    exit 0
}

case "${1:-}" in
    -h|--help|"") usage ;;
esac

url="$1"

yt-dlp \
  -x \
  --audio-format mp3 \
  --audio-quality 0 \
  --embed-thumbnail \
  --convert-thumbnails jpg \
  --add-metadata \
  -o "$HOME/Music/%(title)s.%(ext)s" \
  "$url"
