#!/usr/bin/env bash
set -euo pipefail
# POS: share rclone — Manage pasted rclone remotes (config file) and run safe file ops
# POS_SUBCMDS: remotes show status ls check copy import export
# POS_DEPS: rclone

source "$(dirname "$0")/../lib/common.sh" 2>/dev/null || source "$(dirname "$0")/common.sh"
source "$(dirname "$0")/../lib/share-lib.sh" 2>/dev/null || source "$(dirname "$0")/share-lib.sh"

command -v rclone &>/dev/null || err "rclone not found (install rclone)"

# Persisted-path seam (D6): explicit --config wins, else native RCLONE_CONFIG, else default.
RCLONE_CONF="${RCLONE_CONF:-${RCLONE_CONFIG:-$HOME/.config/rclone/rclone.conf}}"

usage() {
    cat <<'EOF'
Usage: pos share rclone <command> [args]

Manage pasted rclone remotes (config file) and run safe file ops.
The config lives at the rclone-native default (~/.config/rclone/rclone.conf);
bare 'rclone' sees the same remotes. No serve, no sync, no wizard in v1.

Commands:
  remotes [--long]              List configured remotes (is my paste loaded?)
  show [remote]                 Show config with secrets masked (never raw)
  status                        Show which config file is in use + remote count
  ls <remote:path>              List files on a remote (cheapest online check)
  check <src> <dst>             Compare source and destination (read-only)
  copy <src> <dst> [--dry-run]  Copy files (only v1 write op; honors $DRY_RUN)
  import [--file P] [--force]   Save pasted/file INI (validates, chmod 600, no-clobber)
  export [--file P]             Dump raw INI (PLAINTEXT tokens — keep private)

Run without arguments to open the interactive menu.

Config resolution (--config flag > $RCLONE_CONFIG > ~/.config/rclone/rclone.conf):
  All commands accept [--config <path>] for one-shots; without it the tool
  relies on native rclone resolution so external 'rclone' agrees with pos.

Security notes:
  Pasted configs hold long-lived tokens, mostly PLAINTEXT (rclone 'obscure'
  is eyedrop-protection only). The tool chmods 600 on every write, masks
  'show' output, and never logs pasted bodies. 'export' is raw by design.

Examples:
  cat ~/old-rclone.conf | pos share rclone import
  pos share rclone import --file ~/old-rclone.conf
  pos share rclone remotes
  pos share rclone show mydrive
  pos share rclone status
  pos share rclone ls mydrive:backups/
  pos share rclone check /srv/media mydrive:media
  pos share rclone copy /srv/media mydrive:media --dry-run
  pos share rclone export --file /tmp/rclone.conf.bak
EOF
    exit 0
}

sub_help() {
    local sub="${1:-}"
    case "$sub" in
        remotes)
            echo "Usage: pos share rclone remotes [--long] [--config <path>]"
            echo "Example: pos share rclone remotes --long"
            ;;
        show)
            echo "Usage: pos share rclone show [remote] [--config <path>]"
            echo "Example: pos share rclone show mydrive"
            ;;
        status)
            echo "Usage: pos share rclone status [--config <path>]"
            echo "Example: pos share rclone status"
            ;;
        ls)
            echo "Usage: pos share rclone ls <remote:path> [--config <path>]"
            echo "Example: pos share rclone ls mydrive:backups/"
            ;;
        check)
            echo "Usage: pos share rclone check <src> <dst> [--config <path>]"
            echo "Example: pos share rclone check mydrive:a/ /tmp/b/"
            ;;
        copy)
            echo "Usage: pos share rclone copy <src> <dst> [--dry-run] [--config <path>]"
            echo "Example: pos share rclone copy /srv/media mydrive:media --dry-run"
            ;;
        import)
            echo "Usage: pos share rclone import [--file <path>] [--force] [--config <path>]"
            echo "Example: cat ~/rclone.conf | pos share rclone import"
            ;;
        export)
            echo "Usage: pos share rclone export [--file <path>] [--config <path>]"
            echo "Example: pos share rclone export --file /tmp/rclone.conf.bak"
            ;;
        *)
            err "Unknown command '$sub' (see --help)"
            ;;
    esac
    echo "See: pos share rclone --help"
    exit 0
}

# ── Path helpers ────────────────────────────────────────────────
resolved_config_path() {
    local cfg_flag="${1:-}" out path
    if [ -n "$cfg_flag" ]; then
        out="$(rclone --config "$cfg_flag" config file 2>/dev/null || true)"
    else
        out="$(rclone config file 2>/dev/null || true)"
    fi
    path="$(printf '%s\n' "$out" | tail -n 1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    if [ -n "$path" ]; then
        printf '%s' "$path"
        return 0
    fi
    if [ -n "$cfg_flag" ]; then
        printf '%s' "$cfg_flag"
    else
        printf '%s' "$RCLONE_CONF"
    fi
}

count_sections() {
    local file="$1" n
    n="$(grep -cE '^\[.+\]' "$file" 2>/dev/null || true)"
    [ -n "$n" ] || n=0
    printf '%s' "$n"
}

target_occupied() {
    local path="$1"
    [ -f "$path" ] && grep -qE '^\[.+\]' "$path" 2>/dev/null
}

# stdout: remote names without trailing colon, LC_ALL=C sorted, one per line
list_remote_names() {
    local out
    out="$(rclone "$@" listremotes 2>/dev/null || true)"
    [ -n "$out" ] || return 0
    printf '%s\n' "$out" | sed 's/:$//' | LC_ALL=C sort -u
}

# ── Masking (S2.2 literal rule) ─────────────────────────────────
should_mask_key() {
    local lk="$1"
    [ -n "$lk" ] || return 1
    # type + client_id never mask
    if [ "$lk" = "type" ]; then
        return 1
    fi
    if [ "$lk" = "client_id" ]; then
        return 1
    fi
    case "$lk" in
        *token*) return 0 ;;
    esac
    case "$lk" in
        *secret*) return 0 ;;
    esac
    case "$lk" in
        *passwd*) return 0 ;;
    esac
    case "$lk" in
        *password*) return 0 ;;
    esac
    if [ "$lk" = "pass" ]; then
        return 0
    fi
    case "$lk" in
        *_pass*) return 0 ;;
    esac
    case "$lk" in
        *private_key*) return 0 ;;
    esac
    case "$lk" in
        *access_key*) return 0 ;;
    esac
    case "$lk" in
        *secret_key*) return 0 ;;
    esac
    case "$lk" in
        *api_key*) return 0 ;;
    esac
    case "$lk" in
        *auth*) return 0 ;;
    esac
    if [ "$lk" = "key" ] || [[ "$lk" == *_key ]]; then
        case "$lk" in
            *secret*|*private*|*access*|*api*|*auth*|*crypt*) return 0 ;;
        esac
    fi
    return 1
}

# stdin = raw `rclone config show` output; stdout = masked INI
mask_ini() {
    local line keypart valpart keytrim lk
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            \[*\]*)
                printf '%s\n' "$line"
                continue
                ;;
        esac
        case "$line" in
            *=*)
                keypart="${line%%=*}"
                valpart="${line#*=}"
                keytrim="$(printf '%s' "$keypart" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
                lk="$(printf '%s' "$keytrim" | tr '[:upper:]' '[:lower:]')"
                # empty value: verbatim
                if [ -z "$(printf '%s' "$valpart" | tr -d '[:space:]')" ]; then
                    printf '%s\n' "$line"
                    continue
                fi
                if should_mask_key "$lk"; then
                    printf '%s = (set, masked)\n' "$keytrim"
                else
                    printf '%s\n' "$line"
                fi
                ;;
            *)
                printf '%s\n' "$line"
                ;;
        esac
    done
    return 0
}

# ── Commands ────────────────────────────────────────────────────
cmd_remotes() {
    local long=0 cfg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) sub_help remotes ;;
            --long) long=1; shift ;;
            --config)
                [ $# -ge 2 ] || err "Usage: pos share rclone remotes [--long] [--config <path>]"
                cfg="$2"; shift 2 ;;
            *) err "Unknown flag for remotes: $1 (see --help)" ;;
        esac
    done
    local -a rargs=()
    [ -n "$cfg" ] && rargs+=(--config "$cfg")
    local out path
    if [ "$long" -eq 1 ]; then
        out="$(rclone "${rargs[@]}" listremotes --long 2>/dev/null || true)"
    else
        out="$(rclone "${rargs[@]}" listremotes 2>/dev/null || true)"
        rc=0
    fi
    # Normalize: drop blank lines
    out="$(printf '%s\n' "$out" | sed '/^[[:space:]]*$/d')"
    if [ -z "$out" ]; then
        path="$(resolved_config_path "$cfg")"
        warn "No remotes configured (empty config at $path) — add one with: pos share rclone import" >&2
        return 1
    fi
    printf '%s\n' "$out"
}

cmd_show() {
    local cfg="" remote=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) sub_help show ;;
            --config)
                [ $# -ge 2 ] || err "Usage: pos share rclone show [remote] [--config <path>]"
                cfg="$2"; shift 2 ;;
            --*) err "Unknown flag for show: $1 (see --help)" ;;
            *)
                if [ -n "$remote" ]; then
                    err "Usage: pos share rclone show [remote] [--config <path>]"
                fi
                remote="$1"; shift ;;
        esac
    done
    local -a rargs=()
    [ -n "$cfg" ] && rargs+=(--config "$cfg")
    local path raw
    path="$(resolved_config_path "$cfg")"
    if [ -n "$remote" ]; then
        local show_err
        show_err="$(mktemp)"
        if raw="$(rclone "${rargs[@]}" config show "$remote" 2>"$show_err")"; then
            rm -f "$show_err" 2>/dev/null || true
            printf '%s\n' "$raw" | mask_ini
            return 0
        else
            rm -f "$show_err" 2>/dev/null || true
            err "Unknown remote '$remote' (see: pos share rclone remotes)"
        fi
    fi
    raw="$(rclone "${rargs[@]}" config show 2>/dev/null || true)"
    # Empty config: suppress raw, print empty message (no Config: header)
    if [ "$(printf '%s' "$raw" | sed '/^[[:space:]]*$/d')" = "; empty config" ]; then
        warn "No remotes configured (empty config at $path) — add one with: pos share rclone import" >&2
        return 1
    fi
    if [ -z "$(printf '%s' "$raw" | sed '/^[[:space:]]*$/d')" ]; then
        warn "No remotes configured (empty config at $path) — add one with: pos share rclone import" >&2
        return 1
    fi
    log "Config: $path"
    printf '%s\n' "$raw" | mask_ini
}

cmd_status() {
    local cfg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) sub_help status ;;
            --config)
                [ $# -ge 2 ] || err "Usage: pos share rclone status [--config <path>]"
                cfg="$2"; shift 2 ;;
            --*) err "Unknown flag for status: $1 (see --help)" ;;
            *) err "Usage: pos share rclone status [--config <path>]" ;;
        esac
    done
    local -a rargs=()
    [ -n "$cfg" ] && rargs+=(--config "$cfg")
    local path names n vers
    path="$(resolved_config_path "$cfg")"
    names="$(list_remote_names "${rargs[@]}" || true)"
    if [ -z "$names" ]; then
        n=0
    else
        n="$(printf '%s\n' "$names" | wc -l | tr -d ' ')"
    fi
    if command -v rclone >/dev/null 2>&1; then
        vers="$(rclone version 2>/dev/null | head -n 1 | awk '{print $2}')"
        [ -n "$vers" ] || vers="(rclone not probed)"
    else
        vers="(rclone not probed)"
    fi
    log "Config: $path"
    if [ "$n" -eq 0 ]; then
        log "Remotes: 0 ((none))"
    else
        log "Remotes: $n ($(printf '%s' "$names" | tr '\n' ' ' | sed 's/ $//'))"
    fi
    log "rclone: $vers"
    if [ "$n" -eq 0 ]; then
        warn "Empty config — add remotes with: pos share rclone import" >&2
    fi
}

cmd_ls() {
    local cfg="" mode="ls"
    local -a rest=()
    local -a posargs=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) sub_help ls ;;
            --config)
                [ $# -ge 2 ] || err "Usage: pos share rclone ls <remote:path> [--config <path>]"
                cfg="$2"; shift 2 ;;
            --dirs) mode="lsd"; shift ;;
            --files) mode="lsf"; shift ;;
            --bwlimit|--transfers)
                [ $# -ge 2 ] || err "Usage: pos share rclone ls <remote:path> [--config <path>]"
                rest+=("$1" "$2"); shift 2 ;;
            --dry-run|-v|--verbose)
                rest+=("$1"); shift ;;
            --*) rest+=("$1"); shift ;;
            -*) rest+=("$1"); shift ;;
            *) rest+=("$1"); posargs+=("$1"); shift ;;
        esac
    done
    local target=""
    [ "${#posargs[@]}" -gt 0 ] && target="${posargs[0]}"
    [ -n "$target" ] || err "Usage: pos share rclone ls <remote:path> [--config <path>]"
    case "$target" in
        *:*|/*|./*|../*) ;;
        *) err "Usage: pos share rclone ls <remote:path> [--config <path>]" ;;
    esac
    local -a rargs=()
    [ -n "$cfg" ] && rargs+=(--config "$cfg")
    if [ "${DRY_RUN:-0}" -eq 1 ]; then
        log "(dry-run) ls $target"
    fi
    local out errf rc errline path
    out="$(mktemp)"
    errf="$(mktemp)"
    if rclone "${rargs[@]}" "$mode" "${rest[@]}" >"$out" 2>"$errf"; then
        cat "$out"
        rm -f "$out" "$errf" 2>/dev/null || true
        return 0
    else
        rc=$?
    fi
    errline="$(head -n 1 "$errf" 2>/dev/null || true)"
    rm -f "$out" "$errf" 2>/dev/null || true
    # Empty/missing config hint
    path="$(resolved_config_path "$cfg")"
    case "$errline" in
        *empty*|*"didn't find section"*|*"couldn't find remote"*|*"remote not found"*|*"Failed to"*)
            if [ -z "$errline" ]; then
                err "No remotes configured (empty config at $path) — add one with: pos share rclone import"
            fi
            ;;
    esac
    if [ -z "$errline" ]; then
        err "No remotes configured (empty config at $path) — add one with: pos share rclone import"
    fi
    printf '%s\n' "ERROR: $errline" >&2
    printf '%s\n' "  hint: pos share rclone remotes" >&2
    return "$rc"
}

cmd_check() {
    local cfg="" dry=0
    local -a rest=()
    local -a pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) sub_help check ;;
            --config)
                [ $# -ge 2 ] || err "Usage: pos share rclone check <src> <dst> [--config <path>]"
                cfg="$2"; shift 2 ;;
            --dry-run) dry=1; rest+=("$1"); shift ;;
            --bwlimit|--transfers)
                [ $# -ge 2 ] || err "Usage: pos share rclone check <src> <dst> [--config <path>]"
                rest+=("$1" "$2"); shift 2 ;;
            --*) rest+=("$1"); shift ;;
            -*) rest+=("$1"); shift ;;
            *) rest+=("$1"); pos+=("$1"); shift ;;
        esac
    done
    [ "${#pos[@]}" -ge 2 ] || err "Usage: pos share rclone check <src> <dst> [--config <path>]"
    local -a rargs=()
    [ -n "$cfg" ] && rargs+=(--config "$cfg")
    if [ "$dry" -eq 1 ]; then
        log "Dry run — no files will be transferred"
    fi
    if [ "${DRY_RUN:-0}" -eq 1 ]; then
        log "(dry-run) check ${pos[0]} ${pos[1]}"
    fi
    local errfile rc errline path
    errfile="$(mktemp)"
    if rclone "${rargs[@]}" check "${rest[@]}" 2>"$errfile"; then
        rm -f "$errfile" 2>/dev/null || true
        return 0
    else
        rc=$?
    fi
    errline="$(head -n 1 "$errfile" 2>/dev/null || true)"
    rm -f "$errfile" 2>/dev/null || true
    path="$(resolved_config_path "$cfg")"
    if [ -z "$errline" ]; then
        err "No remotes configured (empty config at $path) — add one with: pos share rclone import"
    fi
    printf '%s\n' "ERROR: $errline" >&2
    printf '%s\n' "  hint: pos share rclone remotes" >&2
    return "$rc"
}

cmd_copy() {
    local cfg="" dry=0
    local -a rest=()
    local -a pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) sub_help copy ;;
            --config)
                [ $# -ge 2 ] || err "Usage: pos share rclone copy <src> <dst> [--dry-run] [--config <path>]"
                cfg="$2"; shift 2 ;;
            --dry-run) dry=1; rest+=("$1"); shift ;;
            --bwlimit|--transfers)
                [ $# -ge 2 ] || err "Usage: pos share rclone copy <src> <dst> [--dry-run] [--config <path>]"
                rest+=("$1" "$2"); shift 2 ;;
            --*) rest+=("$1"); shift ;;
            -*) rest+=("$1"); shift ;;
            *) rest+=("$1"); pos+=("$1"); shift ;;
        esac
    done
    [ "${#pos[@]}" -ge 2 ] || err "Usage: pos share rclone copy <src> <dst> [--dry-run] [--config <path>]"
    if [ "${DRY_RUN:-0}" -eq 1 ]; then
        log "(dry-run) would copy ${pos[0]} to ${pos[1]}"
        return 0
    fi
    if [ "$dry" -eq 1 ]; then
        log "Dry run — no files will be transferred"
    fi
    local -a rargs=()
    [ -n "$cfg" ] && rargs+=(--config "$cfg")
    local errfile rc errline path
    errfile="$(mktemp)"
    if rclone "${rargs[@]}" copy "${rest[@]}" 2>"$errfile"; then
        rm -f "$errfile" 2>/dev/null || true
        return 0
    else
        rc=$?
    fi
    errline="$(head -n 1 "$errfile" 2>/dev/null || true)"
    rm -f "$errfile" 2>/dev/null || true
    path="$(resolved_config_path "$cfg")"
    if [ -z "$errline" ]; then
        err "No remotes configured (empty config at $path) — add one with: pos share rclone import"
    fi
    printf '%s\n' "ERROR: $errline" >&2
    printf '%s\n' "  hint: pos share rclone remotes" >&2
    return "$rc"
}

cmd_import() {
    local file="" force=0 cfg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) sub_help import ;;
            --file)
                [ $# -ge 2 ] || err "Usage: pos share rclone import [--file <path>] [--force] [--config <path>]"
                file="$2"; shift 2 ;;
            --force) force=1; shift ;;
            --config)
                [ $# -ge 2 ] || err "Usage: pos share rclone import [--file <path>] [--force] [--config <path>]"
                cfg="$2"; shift 2 ;;
            --*) err "Unknown flag for import: $1 (see --help)" ;;
            *) err "Unknown flag for import: $1 (see --help)" ;;
        esac
    done
    local target
    if [ -n "$cfg" ]; then
        target="$cfg"
    else
        target="$RCLONE_CONF"
    fi
    local tmpdir tmp tmperr
    tmpdir="$(dirname "$target")"
    mkdir -p "$tmpdir"
    tmp="$(mktemp "$tmpdir/.rclone-import.XXXXXX" 2>/dev/null || mktemp /tmp/.rclone-import.XXXXXX)"
    tmperr="$(mktemp)"
    trap 'rm -f "$tmp" "$tmperr" 2>/dev/null || true' INT TERM EXIT
    chmod 600 "$tmp" 2>/dev/null || true
    if [ -n "$file" ]; then
        [ -r "$file" ] || { rm -f "$tmp" "$tmperr" 2>/dev/null || true; trap - INT TERM EXIT; err "File not found or unreadable: $file"; }
        cat "$file" >"$tmp" 2>/dev/null || { rm -f "$tmp" "$tmperr" 2>/dev/null || true; trap - INT TERM EXIT; err "File not found or unreadable: $file"; }
        if ! grep -qE '^\[.+\]' "$tmp" 2>/dev/null; then
            rm -f "$tmp" "$tmperr" 2>/dev/null || true
            trap - INT TERM EXIT
            err "Empty file — nothing imported: $file"
        fi
    else
        if [ -t 0 ]; then
            printf '%s\n' "Paste rclone config INI below ([name] sections with type = ...)." >&2
            printf '%s\n' "Press Ctrl+D on an empty line to finish." >&2
        fi
        cat >"$tmp" 2>/dev/null || true
        if ! grep -qE '^\[.+\]' "$tmp" 2>/dev/null; then
            rm -f "$tmp" "$tmperr" 2>/dev/null || true
            trap - INT TERM EXIT
            err "Empty paste — nothing imported (hint: paste INI then Ctrl+D, or: pos share rclone import --file <path>)"
        fi
    fi
    # Offline parse-validation only (no network)
    local first
    if ! rclone --config "$tmp" config show >"$tmperr" 2>&1; then
        first="$(head -n 1 "$tmperr" 2>/dev/null || true)"
        rm -f "$tmp" "$tmperr" 2>/dev/null || true
        trap - INT TERM EXIT
        printf 'ERROR: Invalid rclone config (rclone config show failed): %s\n' "$first" >&2
        printf '  hint: pos share rclone import --file <path> with a working rclone.conf, or check [name]/type lines\n' >&2
        exit 1
    fi
    rm -f "$tmperr" 2>/dev/null || true
    local n
    n="$(count_sections "$tmp")"
    if [ "${DRY_RUN:-0}" -eq 1 ]; then
        rm -f "$tmp" 2>/dev/null || true
        trap - INT TERM EXIT
        log "(dry-run) would import $n remote(s) to $target"
        return 0
    fi
    if target_occupied "$target"; then
        local existing
        existing="$(count_sections "$target")"
        if [ "$force" -eq 1 ]; then
            warn "Overwriting existing config at $target (--force)" >&2
        else
            if [ -t 0 ]; then
                if ! confirm "Config exists at $target ($existing remote(s)). Overwrite?" n; then
                    rm -f "$tmp" 2>/dev/null || true
                    trap - INT TERM EXIT
                    warn "Config already exists at $target ($existing remote(s)) — not overwriting." >&2
                    warn "See: pos share rclone status" >&2
                    warn "Back up first: pos share rclone export --file /tmp/rclone.conf.bak" >&2
                    warn "Then retry with: pos share rclone import --force" >&2
                    return 1
                fi
            else
                rm -f "$tmp" 2>/dev/null || true
                trap - INT TERM EXIT
                warn "Config already exists at $target ($existing remote(s)) — not overwriting." >&2
                warn "See: pos share rclone status" >&2
                warn "Back up first: pos share rclone export --file /tmp/rclone.conf.bak" >&2
                warn "Then retry with: pos share rclone import --force" >&2
                return 1
            fi
        fi
    fi
    run chmod 600 "$tmp"
    run mv -f "$tmp" "$target"
    run chmod 600 "$target"
    trap - INT TERM EXIT
    log "Imported $n remote(s) to $target (mode 600)"
    log "Verify: pos share rclone remotes"
}

cmd_export() {
    local file="" cfg=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) sub_help export ;;
            --file)
                [ $# -ge 2 ] || err "Usage: pos share rclone export [--file <path>] [--config <path>]"
                file="$2"; shift 2 ;;
            --config)
                [ $# -ge 2 ] || err "Usage: pos share rclone export [--file <path>] [--config <path>]"
                cfg="$2"; shift 2 ;;
            --*) err "Unknown flag for export: $1 (see --help)" ;;
            *) err "Unknown flag for export: $1 (see --help)" ;;
        esac
    done
    local target
    if [ -n "$cfg" ]; then
        target="$cfg"
    else
        target="$RCLONE_CONF"
    fi
    if [ ! -f "$target" ] || ! grep -qE '^\[.+\]' "$target" 2>/dev/null; then
        warn "Nothing to export (empty config at $target) — add remotes with: pos share rclone import" >&2
        return 1
    fi
    local n
    n="$(count_sections "$target")"
    if [ -z "$file" ]; then
        warn "Raw config dump — contains long-lived PLAINTEXT tokens. Do not paste into chat, logs, or issues." >&2
        cat "$target"
        return 0
    fi
    if [ "${DRY_RUN:-0}" -eq 1 ]; then
        log "(dry-run) would export $n remote(s) to $file"
        return 0
    fi
    local destdir tmp
    destdir="$(dirname "$file")"
    mkdir -p "$destdir"
    tmp="$(mktemp "$destdir/.rclone-export.XXXXXX" 2>/dev/null || mktemp /tmp/.rclone-export.XXXXXX)"
    trap 'rm -f "$tmp" 2>/dev/null || true' INT TERM EXIT
    cat "$target" >"$tmp"
    run chmod 600 "$tmp"
    run mv -f "$tmp" "$file"
    run chmod 600 "$file"
    trap - INT TERM EXIT
    log "Exported $n remote(s) to $file (mode 600)"
    warn "That file holds PLAINTEXT tokens — keep it off chat/logs and delete backups when done." >&2
}

# ── Interactive menu ────────────────────────────────────────────
menu_import() {
    local pick fpath
    pick="$(share_pick "Import from" "Paste via stdin" "From file")" || return 0
    case "$pick" in
        1)
            printf '%s\n' "Paste rclone config INI below ([name] sections with type = ...)." >&2
            printf '%s\n' "Press Ctrl+D on an empty line to finish." >&2
            cmd_import || true
            ;;
        2)
            fpath="$(share_ask_value "Config file to import")" || { warn "No file given" >&2; return 1; }
            [ -n "$fpath" ] || { warn "No file given" >&2; return 1; }
            cmd_import --file "$fpath" || true
            ;;
    esac
}

menu_show() {
    local remote
    remote="$(share_ask_value "Remote (name:)")" || { warn "No remote given" >&2; return 1; }
    [ -n "$remote" ] || { warn "No remote given" >&2; return 1; }
    cmd_show "$remote" || true
}

menu_ls() {
    local src
    src="$(share_ask_value "Source <remote:path>")" || { warn "No source given" >&2; return 1; }
    [ -n "$src" ] || { warn "No source given" >&2; return 1; }
    cmd_ls "$src" || true
}

menu_check() {
    local src dst
    src="$(share_ask_value "Source <remote:path>")" || { warn "No source given" >&2; return 1; }
    [ -n "$src" ] || { warn "No source given" >&2; return 1; }
    dst="$(share_ask_value "Destination <remote:path>")" || { warn "No destination given" >&2; return 1; }
    [ -n "$dst" ] || { warn "No destination given" >&2; return 1; }
    cmd_check "$src" "$dst" || true
}

menu_copy() {
    local src dst
    src="$(share_ask_value "Source <remote:path>")" || { warn "No source given" >&2; return 1; }
    [ -n "$src" ] || { warn "No source given" >&2; return 1; }
    dst="$(share_ask_value "Destination <remote:path>")" || { warn "No destination given" >&2; return 1; }
    [ -n "$dst" ] || { warn "No destination given" >&2; return 1; }
    if confirm "Preview with --dry-run first?" y; then
        cmd_copy "$src" "$dst" --dry-run || true
    else
        cmd_copy "$src" "$dst" || true
    fi
}

menu_export() {
    local fpath
    fpath="$(share_ask_value "Export file (empty = stdout)")" || return 0
    if [ -z "$fpath" ]; then
        cmd_export || true
    else
        cmd_export --file "$fpath" || true
    fi
}

run_menu() {
    share_menu_guard || exit 1
    while true; do
        local choice
        choice="$(share_menu_run "rclone remotes (paste-and-use)" \
            "Show status (config path + remotes)" \
            "List remotes" \
            "Show remote config (masked)" \
            "List files on a remote (ls)" \
            "Check integrity (check)" \
            "Copy files (copy, dry-run first)" \
            "Import config (paste or file)" \
            "Export config (raw dump)")" || return 0
        case "$choice" in
            1) cmd_status || true ;;
            2) cmd_remotes || true ;;
            3) menu_show || true ;;
            4) menu_ls || true ;;
            5) menu_check || true ;;
            6) menu_copy || true ;;
            7) menu_import || true ;;
            8) menu_export || true ;;
        esac
    done
}

cmd="${1:-}"
case "$cmd" in
    -h|--help) usage ;;
    ""|menu)
        run_menu
        exit 0
        ;;
    remotes|show|status|ls|check|copy|import|export) ;;
    *) err "Unknown command '$cmd' (see --help)" ;;
esac

# Per-subcommand --help: `pos share rclone <sub> --help` prints the 3-line block.
if [ $# -ge 2 ]; then
    case "${2:-}" in
        -h|--help)
            case "$cmd" in
                remotes|show|status|ls|check|copy|import|export) sub_help "$cmd" ;;
            esac
            ;;
    esac
fi

case "$cmd" in
    remotes) shift; cmd_remotes "$@" ;;
    show) shift; cmd_show "$@" ;;
    status) shift; cmd_status "$@" ;;
    ls) shift; cmd_ls "$@" ;;
    check) shift; cmd_check "$@" ;;
    copy) shift; cmd_copy "$@" ;;
    import) shift; cmd_import "$@" ;;
    export) shift; cmd_export "$@" ;;
esac
